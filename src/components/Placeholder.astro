---
/**
 * Stand-in for an asset or phase-2/3 element that hasn't landed yet.
 * Holds the real dimensions so layout is final before the asset arrives.
 * Every instance names what it's waiting on (see spec section 10).
 */
interface Props {
  label: string;
  note?: string;
  /** CSS aspect-ratio, e.g. "1 / 1" or "4 / 5". Ignored when `height` is set. */
  ratio?: string;
  /** Fixed height, e.g. "320px" or "calc(100vh - var(--header-h))". */
  height?: string;
  class?: string;
}

const { label, note, ratio, height, class: className } = Astro.props;

const style = height ? `height:${height}` : `aspect-ratio:${ratio ?? '16 / 9'}`;
---

<div class:list={['ph', className]} style={style} data-placeholder>
  <span class="ph__label">{label}</span>
  {note && <span class="ph__note">{note}</span>}
</div>

<style>
  .ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    width: 100%;
    padding: var(--space-2);
    border: 1px dashed var(--c-rule);
    border-radius: 2px;
    background: repeating-linear-gradient(
      135deg,
      rgb(184 146 90 / 4%) 0 12px,
      transparent 12px 24px
    );
    color: var(--c-muted);
    text-align: center;
  }

  .ph__label {
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: var(--ls-label);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ph__note {
    max-width: 42ch;
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.7;
  }
</style>
