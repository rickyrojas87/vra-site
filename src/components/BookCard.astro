---
/**
 * Book card (artboard .book) — Home shelf and the Works catalog. The cover
 * stands tilted in a green pool; title, author and genre, one meta line, and
 * the call to action pinned to the foot.
 *
 * The two artboards word the meta line differently:
 *   shelf   (Home)   "4.3 ★ · 10.9 hrs"             / "Coming soon to Audible"
 *   catalog (Works)  "10.9 hrs · 4.3 ★ (4 ratings)" / "In production · Coming soon"
 *
 * A published title with an Audible link makes the whole card the link; an
 * in-production title is a plain block.
 */
import { Image } from 'astro:assets';
import type { ShelfItem } from '../utils/catalog';
import type { Title } from '../utils/content';

interface Props {
  entry: Title;
  ribbon?: ShelfItem['ribbon'];
  variant?: 'shelf' | 'catalog';
}

const { entry, ribbon = null, variant = 'shelf' } = Astro.props;
const t = entry.data;
const wip = t.status === 'in-production';
const href = wip ? undefined : t.audibleUrl;
const Tag = href ? 'a' : 'div';

/** 10.93 -> "10.9 hrs", 9.98 -> "10 hrs". */
const hrs = t.runtimeHours ? `${Number(t.runtimeHours.toFixed(1))} hrs` : undefined;
const stars = t.audibleRating !== undefined ? `${t.audibleRating.toFixed(1)} ★` : undefined;
const count = t.ratingCount ? ` (${t.ratingCount} rating${t.ratingCount === 1 ? '' : 's'})` : '';

const genreLine = [
  t.author,
  [t.genre, variant === 'catalog' && t.seriesNumber ? `Book ${t.seriesNumber}` : undefined]
    .filter(Boolean)
    .join(', '),
]
  .filter(Boolean)
  .join(' · ');

const metaLine = wip
  ? variant === 'catalog'
    ? 'In production · Coming soon'
    : 'Coming soon to Audible'
  : variant === 'catalog'
    ? [hrs, stars ? `${stars}${count}` : 'Not yet rated'].filter(Boolean).join(' · ')
    : [stars, hrs].filter(Boolean).join('  ·  ');

const cta = wip ? 'Coming soon' : href ? 'Listen on Audible ↗' : undefined;

const ribbonText = {
  'just-published': 'Just published',
  'in-production': 'In production',
} as const;
---

<Tag
  class:list={['book', { wip }]}
  {...(href ? { href, target: '_blank', rel: 'noopener' } : {})}
>
  <div class="book-art">
    {
      ribbon && (
        <span class="ribbon-wrap">
          <span class:list={['ribbon', { 'ribbon--green': ribbon === 'in-production' }]}>
            {ribbonText[ribbon]}
          </span>
        </span>
      )
    }
    {
      t.coverImage ? (
        <Image
          class="book-cover"
          src={t.coverImage}
          alt={`Cover of ${t.title}`}
          width={180}
          height={180}
          densities={[1, 2]}
          fit="cover"
          loading="lazy"
          fetchpriority="low"
        />
      ) : (
        <span class="book-cover book-cover--blank">{t.title}</span>
      )
    }
  </div>
  <div class="book-body">
    <div class="book-t">{t.title}</div>
    {genreLine && <div class="book-m">{genreLine}</div>}
    {metaLine && <div class="book-m">{metaLine}</div>}
    {cta && <div class="book-link">{cta}</div>}
  </div>
</Tag>

<style>
  .book {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--c-bg);
    box-shadow:
      var(--shadow-card),
      inset 0 0 0 1px var(--c-card-edge);
    color: var(--c-text);
    text-decoration: none;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.45s;
  }

  .book:hover {
    transform: translateY(-10px);
    color: var(--c-text);
    box-shadow:
      0 40px 80px rgb(0 0 0 / 50%),
      inset 0 0 0 1px var(--c-accent);
  }

  .book-art {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 250px;
    overflow: hidden;
    perspective: 900px;
    background: radial-gradient(
      ellipse 70% 80% at 50% 45%,
      var(--c-hunter-light) 0%,
      var(--c-hunter) 45%,
      var(--c-hunter-deep) 100%
    );
    border-bottom: 1px solid rgb(212 175 55 / 25%);
  }

  .book-cover {
    position: relative;
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: -14px 22px 40px rgb(0 0 0 / 60%);
    transform: rotateY(12deg) rotateX(2deg);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .book-cover--blank {
    display: grid;
    place-items: center;
    padding: 16px;
    background: var(--c-panel);
    font-family: var(--font-display);
    font-size: 22px;
    text-align: center;
  }

  .book:hover .book-cover {
    transform: rotateY(0) scale(1.05);
  }

  .book-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    padding: 20px 22px 22px;
  }

  .book-t {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.15;
  }

  .book-m {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--c-muted);
    white-space: pre-wrap;
  }

  .book-link {
    margin-top: auto;
    padding-top: 14px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .book.wip .book-cover {
    filter: saturate(0.6) brightness(0.75);
  }

  .book.wip .book-link {
    color: var(--c-emerald-glow);
  }

  /* Ribbon sits a touch higher and further in than the global default. */
  .ribbon-wrap {
    top: -2px;
    right: 28px;
  }

  @media (max-width: 560px) {
    .book-art {
      height: 220px;
    }
  }
</style>
