---
/**
 * Book card — Home shelf (02) and the Works catalog. Cover, title, author,
 * genre and runtime, then either the Audible rating or "Coming soon".
 *
 * A published title with an Audible link makes the whole card the link; an
 * in-production title is a plain block. The optional ribbon hangs from the
 * card top (styles in global.css).
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatRuntime } from '../utils/format';
import type { ShelfItem } from '../utils/catalog';

interface Props {
  entry: CollectionEntry<'titles'>;
  ribbon?: ShelfItem['ribbon'];
  /** Show a visible "Listen on Audible" line (Works) under the rating. */
  linkLabel?: boolean;
}

const { entry, ribbon = null, linkLabel = false } = Astro.props;
const t = entry.data;
const href = t.status === 'published' ? t.audibleUrl : undefined;
const Tag = href ? 'a' : 'div';

const ribbonText = {
  'just-published': 'Just published',
  'in-production': 'In production',
} as const;
---

<Tag class="card book" {...(href ? { href, target: '_blank', rel: 'noopener' } : {})}>
  {
    ribbon && (
      <span class="ribbon-wrap">
        <span class:list={['ribbon', { 'ribbon--green': ribbon === 'in-production' }]}>
          {ribbonText[ribbon]}
        </span>
      </span>
    )
  }

  <span class="book__cover">
    {
      t.coverImage ? (
        <Image
          src={t.coverImage}
          alt={`Cover of ${t.title}`}
          width={520}
          height={520}
          widths={[260, 520]}
          sizes="(min-width: 900px) 240px, 45vw"
          fit="cover"
        />
      ) : (
        <span class="book__cover-fallback">{t.title}</span>
      )
    }
  </span>

  <span class="book__body">
    <span class="book__title">{t.title}</span>
    {t.author && <span class="book__author">{t.author}</span>}
    <span class="book__meta">
      {[t.genre, t.runtimeHours && formatRuntime(t.runtimeHours)].filter(Boolean).join(' · ')}
    </span>
    {
      t.status === 'in-production' ? (
        <span class="book__status">Coming soon</span>
      ) : (
        t.audibleRating !== undefined && (
          <span class="book__rating">
            <span aria-hidden="true">&#9733;</span> {t.audibleRating.toFixed(1)}
            {t.ratingCount !== undefined && <span class="book__count">({t.ratingCount})</span>}
            <span class="visually-hidden"> out of 5 on Audible</span>
          </span>
        )
      )
    }
    {
      linkLabel && href && (
        <span class="book__link">
          Listen on Audible
          <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </span>
      )
    }
  </span>
</Tag>

<style>
  .book {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 12px;
    color: var(--c-text-body);
  }

  .book__cover {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 14px;
  }

  .book__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book__cover-fallback {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--space-1);
    background: var(--c-panel);
    font-family: var(--font-display);
    font-size: 22px;
    text-align: center;
  }

  .book__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-1) 6px 6px;
  }

  .book__title {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.15;
  }

  .book__author {
    font-size: 14px;
    color: var(--c-text-card);
  }

  .book__meta {
    font-size: 13px;
    color: var(--c-text-caption);
  }

  .book__rating {
    margin-top: 4px;
    font-size: 14px;
    color: var(--c-accent);
  }

  .book__count {
    margin-left: 4px;
    color: var(--c-text-caption);
  }

  .book__status {
    margin-top: 4px;
    font-size: 13px;
    font-weight: var(--fw-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-emerald-glow);
  }

  /* Pinned to the card foot so the links line up along a row. */
  .book__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: var(--space-1);
    font-size: var(--fs-label);
    font-weight: var(--fw-button);
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .book:hover .btn__arrow {
    transform: translateX(5px);
  }
</style>
