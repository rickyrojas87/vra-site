---
/**
 * Stats strip under the hero — spec v2 §3. Every number is computed from the
 * catalog at build (src/utils/catalog.ts); nothing here is typed by hand.
 *
 * A 42s marquee: the list renders twice and the track slides by exactly one
 * copy, so the loop is seamless. The second copy is aria-hidden; screen
 * readers get the list once. Under reduced motion the track stops, the copy
 * goes, and the list wraps instead of clipping.
 *
 * Moving content that runs longer than five seconds needs a way to stop it
 * (WCAG 2.2.2), so a pause/play button sits at the strip's end. It ships
 * `hidden` and the script reveals it: without JS it could do nothing. Hover
 * still pauses too. Under reduced motion there is nothing to pause, so the
 * button stays hidden.
 */
import { loadStats } from '../utils/catalog';

const stats = await loadStats();

const items = [
  { value: String(stats.published), label: 'Published titles' },
  stats.averageRating && { value: stats.averageRating, label: 'Average rating' },
  stats.ratingCount > 0 && { value: String(stats.ratingCount), label: 'Listener ratings' },
  stats.finishedHours > 0 && { value: String(stats.finishedHours), label: 'Finished hours' },
  { value: String(stats.accents), label: 'Accents' },
  { value: 'ACX', label: 'Compliant delivery' },
  { value: 'In-house', label: 'Editing and mastering' },
].filter((item): item is { value: string; label: string } => Boolean(item));
---

<section class="stats surface-deep" aria-label="At a glance" data-stats>
  <div class="stats__viewport">
    <div class="stats__track">
      {
        [false, true].map((copy) => (
          <ul class="stats__list" aria-hidden={copy ? 'true' : undefined}>
            {items.map((item) => (
              <li class="stats__item">
                <span class="stats__value">{item.value}</span>
                <span class="stats__label">{item.label}</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <button class="btn btn--bookplate btn--small stats__toggle" type="button" hidden data-stats-toggle>
    <svg class="stats__icon" viewBox="0 0 12 12" aria-hidden="true">
      <path class="stats__pause" d="M3 2h2v8H3zM7 2h2v8H7z" fill="currentColor"></path>
      <path class="stats__play" d="M3 1.5v9l7.5-4.5z" fill="currentColor"></path>
    </svg>
    <span data-stats-label>Pause</span>
    <span class="visually-hidden"> scrolling figures</span>
  </button>
</section>

<style>
  .stats {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding-block: var(--space-2);
    padding-right: var(--space-1);
    border-block: 1px solid var(--c-rule);
  }

  .stats__viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .stats__toggle {
    flex: none;
  }

  /* `.btn` sets a display, which would otherwise beat the attribute. */
  .stats__toggle[hidden] {
    display: none;
  }

  .stats__play,
  .stats.is-paused .stats__pause {
    display: none;
  }

  .stats.is-paused .stats__play {
    display: inline;
  }

  .stats__icon {
    width: 12px;
    height: 12px;
    flex: none;
  }

  .stats__track {
    display: flex;
    width: max-content;
    animation: stats-marquee 42s linear infinite;
  }

  .stats:hover .stats__track,
  .stats.is-paused .stats__track {
    animation-play-state: paused;
  }

  .stats__list {
    display: flex;
    flex: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stats__item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-inline: var(--space-3);
    white-space: nowrap;
  }

  /* Gold diamond between items, matching the gold thread's terminal. */
  .stats__item::after {
    content: '';
    align-self: center;
    width: 6px;
    height: 6px;
    margin-left: var(--space-3);
    background: var(--c-accent);
    opacity: 0.7;
    transform: rotate(45deg);
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 400;
    line-height: 1;
    color: var(--c-accent);
  }

  .stats__label {
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-text-caption);
  }

  @keyframes stats-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stats__track {
      width: auto;
      justify-content: center;
    }

    .stats__list {
      flex: 1;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: var(--space-1);
    }

    .stats__list[aria-hidden] {
      display: none;
    }

    .stats__toggle {
      display: none;
    }
  }
</style>

<script>
  const strip = document.querySelector<HTMLElement>('[data-stats]');
  const toggle = strip?.querySelector<HTMLButtonElement>('[data-stats-toggle]');

  if (strip && toggle) {
    const label = toggle.querySelector<HTMLElement>('[data-stats-label]')!;

    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const paused = strip.classList.toggle('is-paused');
      label.textContent = paused ? 'Play' : 'Pause';
    });
  }
</script>
