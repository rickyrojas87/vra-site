---
/**
 * Person JSON-LD — spec section 9. Emitted on every page from BaseLayout.
 *
 * Every value is real. `sameAs` carries only profiles that actually exist, and
 * a link still awaiting a URL is dropped rather than guessed at.
 */
import { site, externalLinks } from '../data/site';

const origin = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, '');

const sameAs = externalLinks
  .map((link) => link.href)
  .filter((href): href is string => Boolean(href));

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${origin}/#victoria-rojas`,
  name: site.name,
  jobTitle: 'Audiobook Narrator',
  url: `${origin}/`,
  image: `${origin}/og-default.jpg`,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Texas',
    addressCountry: 'US',
  },
  ...(sameAs.length ? { sameAs } : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />
