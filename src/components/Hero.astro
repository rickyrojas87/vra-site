---
/**
 * Home hero — artboard section.hero: the nav row, then a title page beside
 * the photo, over the looping library video.
 *
 * Video rules, all of them load-bearing for Lighthouse:
 *   - The <video> ships with NO source and `preload="none"`. The poster is a
 *     responsive <img> beneath it (640px on phones), not the `poster`
 *     attribute, which can't vary by viewport. It is the LCP element, so it
 *     loads eagerly at high priority; the video fades in over it once playing.
 *     The tagline font is inlined beside it (HeroPreloads.astro) and is
 *     `font-display: optional`, so it never swaps in after first paint.
 *   - Sources are attached after `window.load`, so the video never competes
 *     with first paint or LCP.
 *   - Under prefers-reduced-motion, or on a connection reporting `saveData`,
 *     the sources are never attached and the poster is all there is. The
 *     global reduced-motion rule stops every other hero animation.
 *   - Only at 900px and wider: the spec's fallback for mobile performance,
 *     which measurement required (see VIDEO_MIN_WIDTH).
 *
 * Not revealed: the hero holds the LCP element, and fading it in would delay
 * the largest paint by the length of the animation.
 */
import { Image } from 'astro:assets';
import Header from './Header.astro';
import Dust from './Dust.astro';
import Spark from './Spark.astro';
import { loadBookingMonth, loadLatestRelease } from '../utils/catalog';
import { heroMedia } from '../data/heroMedia';
/**
 * Laughing at the microphone: the artboard's hero photo, which is the
 * landscape main.jpg shown in a 440x600 frame at object-position 52% 18%.
 * That crop is deterministic (full height, 52% of the way across), so
 * hero-main.jpg IS that crop, pre-cut from main.jpg, and the page serves a
 * file the size of the frame rather than the whole landscape at 1600px.
 * Regenerate from main.jpg if the photo changes (11:15, x = (W - H*11/15) * .52).
 */
import heroPhoto from '../assets/hero-main.jpg';
import { getHeroPoster } from '../utils/heroPoster';

const booking = await loadBookingMonth();
const poster = await getHeroPoster();
const latest = await loadLatestRelease();

/**
 * Spec v2 §4 fallback, applied: with the video attached on phones, mobile
 * Lighthouse measured 91 (LCP 3.4s) — the first video frame repainted the
 * LCP element after load. Below 900px the poster alone is shown.
 */
const VIDEO_MIN_WIDTH = 900;

/**
 * Four sparks around the photo (artboard): positions are in the stylesheet
 * (.hero-spark--1..4) so phones can pull the side ones inside the viewport.
 */
const sparkCount = 4;

const miniBarDelays = ['0s', '.2s', '.4s', '.1s', '.3s'];
---

<section class="hero" data-hero aria-label="Introduction">
  <div class="hero__media" aria-hidden="true">
    {/* Same URLs as the <head> preload; see utils/heroPoster.ts. */}
    <img
      class="hero__poster"
      src={poster.src}
      srcset={poster.srcSet.attribute}
      sizes={poster.attributes.sizes}
      width={poster.attributes.width}
      height={poster.attributes.height}
      alt=""
      decoding="async"
      fetchpriority="high"
    />
    <video
      class="hero__video"
      data-hero-video
      data-min-width={VIDEO_MIN_WIDTH}
      data-webm={heroMedia.webm}
      data-mp4={heroMedia.mp4}
      width="1280"
      height="720"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      tabindex="-1"></video>
    <div class="glow"></div>
    <div class="glow-green"></div>
    <div class="scrim"></div>
  </div>

  <Dust seed={11} />

  <div class="container">
    <Header />

    <div class="hero-grid">
      <div class="title-page">
        <p class="pill">
          <span class="dot" aria-hidden="true"></span>
          <span>Now booking <span class="pill-month">{booking.month}{booking.year && ` ${booking.year}`}</span> productions</span>
        </p>
        <div class="rule rule-a rule-a--first" aria-hidden="true"></div>
        <div class="rule rule-b" aria-hidden="true"></div>
        <p class="eyebrow hero__eyebrow">Audiobook Narrator</p>
        <h1 class="hero__title">Victoria<br />Rojas</h1>
        <p class="hand hand--bright hero__tagline">A voice for every story.</p>
        <div class="rule rule-b hero__rule-close" aria-hidden="true"></div>
        <div class="rule rule-a" aria-hidden="true"></div>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/works">
            <svg class="btn__play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M7 4.5v15l13-7.5z"></path>
            </svg>
            Hear demos
          </a>
          <a class="btn btn--bookplate" href="/contact">
            Request a quote
            <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="photo hero-photo">
        {/* Eager, so it is there on desktop where it sits beside the title,
            but low priority: the poster behind it is the LCP element and
            must win the connection. 2x for the 440px frame = 880px. */}
        <div class="photo-frame frame">
          <Image
            src={heroPhoto}
            alt="Victoria Rojas laughing at the microphone in her recording booth"
            width={440}
            height={600}
            densities={[1, 2]}
            quality={85}
            loading="eager"
            fetchpriority="low"
          />
        </div>
        {Array.from({ length: sparkCount }, (_, i) => <Spark class={`hero-spark--${i + 1}`} />)}

        {
          latest && (
            <a
              class="np"
              href={latest.data.audibleUrl ?? '/works'}
              {...(latest.data.audibleUrl ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {latest.data.coverImage && (
                <Image
                  src={latest.data.coverImage}
                  alt=""
                  width={54}
                  height={54}
                  densities={[1, 2]}
                  fit="cover"
                  fetchpriority="low"
                />
              )}
              <span class="np__text">
                <span class="np__label">Latest release</span>
                <span class="np__title">{latest.data.title}</span>
                {latest.data.author && <span class="np__author">{latest.data.author}</span>}
              </span>
              <span class="mini-bars" aria-hidden="true">
                {miniBarDelays.map((d) => (
                  <span style={`animation-delay:${d}`} />
                ))}
              </span>
            </a>
          )
        }
      </div>
    </div>
  </div>

  <div class="scroll-cue" aria-hidden="true">Scroll</div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 940px;
    overflow: hidden;
    background: var(--c-deep);
  }

  /* --- Media layers ------------------------------------------------------ */

  .hero__media,
  .hero__media > * {
    position: absolute;
    inset: 0;
  }

  .hero__media {
    z-index: -1;
  }

  .hero__poster,
  .hero__video {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    filter: brightness(0.7) saturate(0.95) blur(0.6px);
    /* blur() bleeds the edge to transparent; overscan hides it. */
    transform: scale(1.02);
  }

  /* Hidden until frames are actually playing, so the poster never flashes
     to black while the video buffers. */
  .hero__video {
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero__video.is-playing {
    opacity: 1;
  }

  /* Warm lamplight, upper left, flickering (artboard .glow). */
  .glow {
    background: radial-gradient(ellipse 55% 60% at 24% 30%, rgb(255 168 76 / 18%), rgb(255 168 76 / 0%) 60%);
    mix-blend-mode: screen;
    animation: flicker 5.5s ease-in-out infinite;
  }

  .glow-green {
    background: radial-gradient(ellipse 50% 55% at 82% 72%, rgb(31 77 58 / 55%), rgb(31 77 58 / 0%) 70%);
  }

  /* Holds the type's contrast over any frame of the video, then hands off to
     the page surface along the bottom edge (artboard .scrim). */
  .scrim {
    background:
      linear-gradient(90deg, rgb(18 15 12 / 94%) 0%, rgb(18 15 12 / 72%) 42%, rgb(18 15 12 / 28%) 100%),
      linear-gradient(180deg, rgb(18 15 12 / 55%) 0%, rgb(18 15 12 / 0%) 22%, rgb(34 35 40 / 0%) 70%, var(--c-bg) 100%);
  }

  /* --- Title page --------------------------------------------------------- */

  .hero-grid {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 56px;
    align-items: center;
    padding: 64px 0 140px;
  }

  .title-page {
    text-align: center;
  }

  .title-page .pill {
    margin-bottom: 28px;
  }

  .hero__eyebrow {
    margin-top: 30px;
    color: var(--c-accent);
  }

  .hero__title {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--c-text-body);
  }

  /* 48px at every width, as the artboard renders it: its mobile `.tagline`
     sizes never reach the script tagline (`.tagline.script` outranks them). */
  .hero__tagline {
    margin-top: 22px;
    font-size: 48px;
    line-height: 1.1;
    text-shadow: 0 0 24px rgb(212 175 55 / 35%);
  }

  .hero__rule-close {
    margin-top: 30px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 36px;
  }

  .btn__play {
    width: 14px;
    height: 14px;
    flex: none;
  }

  /* --- Photo -------------------------------------------------------------- */

  .hero-photo {
    justify-self: end;
    width: 440px;
    height: 600px;
  }

  .hero-photo .frame {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Artboard spark positions, offsets from .hero-photo. */
  .hero-photo :global(.hero-spark--1) {
    top: -14px;
    right: 26px;
  }

  .hero-photo :global(.hero-spark--2) {
    top: 38px;
    right: -22px;
    width: 12px;
    height: 12px;
    animation-delay: 1.1s;
  }

  .hero-photo :global(.hero-spark--3) {
    top: 150px;
    left: -24px;
    width: 14px;
    height: 14px;
    animation-delay: 2.2s;
  }

  .hero-photo :global(.hero-spark--4) {
    right: -18px;
    bottom: 120px;
    width: 22px;
    height: 22px;
    animation-delay: 0.6s;
  }

  /* Latest release card, overhanging the photo's left edge (artboard .np). */
  .np {
    position: absolute;
    bottom: 54px;
    left: -90px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 18px 12px 12px;
    border-radius: 16px;
    background: rgb(27 28 32 / 82%);
    backdrop-filter: blur(10px);
    box-shadow:
      0 20px 50px rgb(0 0 0 / 50%),
      inset 0 0 0 1px rgb(184 146 90 / 35%);
    color: var(--c-text-body);
    animation: bob 6s ease-in-out infinite;
  }

  .np :global(img) {
    display: block;
    flex: none;
    width: 54px;
    height: 54px;
    border-radius: 8px;
    object-fit: cover;
  }

  .np__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .np__label {
    font-size: 10px;
    font-weight: var(--fw-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-emerald-glow);
  }

  .np__title {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.1;
  }

  .np__author {
    font-size: 12px;
    color: var(--c-muted);
  }

  .mini-bars {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 22px;
  }

  .mini-bars span {
    width: 3px;
    border-radius: 2px;
    background: var(--c-accent);
    animation: eq 1.1s ease-in-out infinite;
  }

  .scroll-cue {
    position: absolute;
    bottom: 18px;
    left: 50%;
    z-index: 4;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--c-muted);
    transform: translateX(-50%);
  }

  @keyframes flicker {
    0%,
    100% {
      opacity: 0.9;
    }

    22% {
      opacity: 1;
    }

    38% {
      opacity: 0.82;
    }

    55% {
      opacity: 0.97;
    }

    71% {
      opacity: 0.86;
    }
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes eq {
    0%,
    100% {
      height: 5px;
    }

    50% {
      height: 22px;
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 40px 0 90px;
    }

    .hero__title {
      font-size: 56px;
      letter-spacing: 0.1em;
    }

    .hero-photo {
      justify-self: center;
      width: min(440px, 100%);
      height: auto;
      max-height: 600px;
      aspect-ratio: 11 / 15;
    }

    .np {
      bottom: 24px;
      left: -20px;
    }
  }

  @media (max-width: 560px) {
    .hero__title {
      font-size: 44px;
      letter-spacing: 0.08em;
      line-height: 1.02;
    }

    .hero-photo {
      width: 100%;
    }

    /* The photo spans the column here, so the side sparks would hang past
       the 16px gutter and be cut off at the viewport edge. Keep them inside. */
    .hero-photo :global(.hero-spark--2),
    .hero-photo :global(.hero-spark--4) {
      right: -12px;
    }

    .hero-photo :global(.hero-spark--3) {
      left: -12px;
    }

    .np {
      bottom: 16px;
      left: -4px;
      gap: 10px;
      padding: 10px 14px 10px 10px;
    }

    .np :global(img) {
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  /**
   * Attaches the hero video's sources after the page has fully loaded. Until
   * then (and forever, under reduced motion or Save-Data) only the poster
   * exists, so no video byte competes with first paint.
   */
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

  if (video) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
      ?.saveData;
    const minWidth = Number(video.dataset.minWidth || 0);

    const attach = () => {
      if (reduced.matches || saveData || window.innerWidth < minWidth) return;

      for (const [type, src] of [
        ['video/webm', video.dataset.webm],
        ['video/mp4', video.dataset.mp4],
      ]) {
        if (!src) continue;
        const source = document.createElement('source');
        source.type = type!;
        source.src = src;
        video.append(source);
      }
      video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
      video.load();
      video.play().catch(() => {
        /* Autoplay refused: the poster stays, which is the designed fallback. */
      });
    };

    if (document.readyState === 'complete') attach();
    else window.addEventListener('load', attach, { once: true });

    // Turning reduced motion on mid-visit stops the loop and shows the poster.
    reduced.addEventListener('change', () => {
      if (reduced.matches) {
        video.pause();
        video.classList.remove('is-playing');
        video.removeAttribute('autoplay');
        // Drop the sources before load(), or load() would fetch them again.
        for (const source of video.querySelectorAll('source')) source.remove();
        video.load();
      }
    });
  }
</script>
