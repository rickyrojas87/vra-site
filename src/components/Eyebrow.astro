---
/**
 * Section eyebrow with a gold chapter number: "01 | The listening room"
 * (artboard .label + .no). Styles in global.css (`.eyebrow`). Without a
 * chapter (the closing call-to-action band) it is the label alone.
 */
interface Props {
  /** Chapter number, 1–7. Rendered two-digit. */
  chapter?: number;
  label: string;
}

const { chapter, label } = Astro.props;
---

<p class="eyebrow">
  {chapter !== undefined && <span class="eyebrow__num">{String(chapter).padStart(2, '0')}</span>}{label}
</p>
