---
/** CTA band — Home section 6, reused on About and Works. 240px tall. */
interface Props {
  heading?: string;
  cta?: string;
  href?: string;
}

const {
  heading = "Let's talk about your book.",
  cta = 'Request a quote',
  href = '/contact',
} = Astro.props;
---

<section class="band">
  <div class="container band__inner">
    <h2 class="band__heading">{heading}</h2>
    <a class="btn btn--primary" href={href}>{cta}</a>
  </div>
</section>

<style>
  .band {
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid var(--c-rule);
  }

  .band__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: 240px;
    padding-block: var(--space-4);
    text-align: center;
  }

  .band__heading {
    font-size: var(--fs-h2);
    font-weight: var(--fw-h2);
    letter-spacing: var(--ls-h2);
    color: var(--c-text);
  }
</style>
