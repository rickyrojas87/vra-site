---
/**
 * CTA band — the last band on About and Works (spec v2 §5). Gold thread,
 * one line and the gold-leaf button. It always sits directly above the deep
 * footer, so it is never deep itself and fades out into it.
 */
import GoldThread from './GoldThread.astro';
import Dust from './Dust.astro';

type Surface = 'base' | 'panel';

interface Props {
  cta?: string;
  href?: string;
  surface?: Surface;
  /** The previous section's surface, for the soft join. */
  joinFrom: 'base' | 'deep' | 'panel';
}

const { cta = 'Request a quote', href = '/contact', surface = 'panel', joinFrom } = Astro.props;
---

<section
  class:list={['section', `surface-${surface}`, 'join', `join--from-${joinFrom}`, 'join--to-deep', 'band']}
>
  <Dust seed={99} count={14} />
  <div class="container band__inner reveal">
    <GoldThread />
    <h2 class="section-title band__heading">
      <slot>Let's talk about <em>your book.</em></slot>
    </h2>
    <a class="btn btn--primary" href={href}>
      {cta}
      <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
  }

  .band__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  /* The thread's own bottom margin plus the gap would double up. */
  .band__inner > :global(.thread) {
    margin-bottom: 0;
  }
</style>
