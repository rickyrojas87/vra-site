---
/**
 * Closing band on About and Works (artboard section.cta, centred variant):
 * "Start here" with no chapter number, one line and two actions. It always
 * sits directly above the deep footer, so it is never deep itself and fades
 * out into it.
 */
import SectionHead from './SectionHead.astro';
import GoldThread from './GoldThread.astro';

interface Props {
  surface?: 'base' | 'panel';
  /** The previous section's surface, for the soft join. */
  joinFrom: 'base' | 'deep' | 'panel';
}

const { surface = 'base', joinFrom } = Astro.props;
---

<section
  class:list={['section', `surface-${surface}`, 'join', `join--from-${joinFrom}`, 'join--to-deep', 'band']}
  aria-labelledby="band-title"
>
  <GoldThread />
  <div class="container band__inner reveal">
    <SectionHead label="Start here" align="center" id="band-title" class="band__head">
      Let&rsquo;s talk about <em>your book.</em>
    </SectionHead>
    <div class="band__actions">
      <a class="btn btn--primary" href="/contact">
        Request a quote
        <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </a>
      <a class="btn btn--bookplate" href="/works">Hear demos</a>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: 120px;
  }

  .band__inner {
    position: relative;
  }

  .band__head :global(.section-title) {
    font-size: 56px;
  }

  .band__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 34px;
  }

  @media (max-width: 900px) {
    .band {
      padding-block: 110px 100px;
    }

    .band__head :global(.section-title) {
      font-size: 44px;
    }
  }
</style>
