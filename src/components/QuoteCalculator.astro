---
/**
 * Quote calculator — spec section 6, row 2 (spec section 8, phase 3).
 *
 * Plain JS, no dependencies, inlined like the waveform player. Every rate and
 * every line of service copy comes from src/data/pricing.ts.
 *
 * The output area stays hidden until a valid word count exists, so the panel
 * never shows a zero, a NaN or a placeholder dash.
 */
import {
  services,
  defaultServiceId,
  WORDS_PER_FINISHED_HOUR,
  ESTIMATE_DISCLAIMER,
  ARRANGEMENTS_NOTE,
} from '../data/pricing';

interface Props {
  /**
   * id of the section holding the intake form, for the handoff scroll. When
   * the page has no such section (Home), the handoff instead opens /contact
   * with the estimate in the query string, and the calculator there picks it up.
   */
  formTarget?: string;
  /** Pre-fill so the figures show on arrival instead of dashes. */
  initialWords?: number;
  /** Contact (spec v2 §5): the rate each figure is worked from, under it. */
  showRates?: boolean;
}

const { formTarget = 'intake', initialWords, showRates = false } = Astro.props;

/** Slider bounds — spec v2 §3, row 07. The text field accepts any count. */
const RANGE = { min: 10_000, max: 150_000, step: 1_000 };

const config = {
  services,
  wordsPerHour: WORDS_PER_FINISHED_HOUR,
  formTarget,
  range: RANGE,
};

const clampToRange = (n: number) => Math.min(RANGE.max, Math.max(RANGE.min, n));

/** Server-rendered so the rate cell is never blank before the script runs. */
const defaultService = services.find((s) => s.id === defaultServiceId) ?? services[0];
---

<div class="card calc" data-calc>
  <div class="calc__controls">
    <div class="calc__field">
      <h3 class="label calc__legend" id="calc-service">Service</h3>
      <div class="seg" role="group" aria-labelledby="calc-service" data-seg>
        {
          services.map((service) => (
            <button
              class="seg__btn"
              type="button"
              data-service={service.id}
              aria-pressed={service.id === defaultServiceId ? 'true' : 'false'}
            >
              <span class="seg__name">{service.name}</span>
              <span class="seg__meta">
                {service.qualifier} &middot; ${service.rate} per finished hour
              </span>
            </button>
          ))
        }
      </div>
      <p class="calc__desc" data-desc>{defaultService.description}</p>
    </div>

    <div class="calc__field">
      <label class="label calc__legend" for="calc-words">Manuscript word count</label>
      <input
        class="calc__input"
        id="calc-words"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        placeholder="90,000"
        aria-describedby="calc-note"
        value={initialWords ? initialWords.toLocaleString('en-US') : undefined}
        data-words
      />
      {/* Mirrors the text field; either one drives the other. */}
      <input
        class="calc__range"
        type="range"
        min={RANGE.min}
        max={RANGE.max}
        step={RANGE.step}
        value={clampToRange(initialWords ?? 90_000)}
        aria-label="Manuscript word count"
        data-range
      />
      <p class="calc__scale" aria-hidden="true">
        <span>10k words</span>
        <span>150k words</span>
      </p>
    </div>
  </div>

  {/* Always rendered. Empty input shows em-dashes, never 0.0 or $0. */}
  <div class="calc__out" data-out>
    <dl class="calc__figures">
      <div class="calc__figure">
        <dt class="calc__key">Estimated finished hours</dt>
        <dd class="calc__val" data-hours>&mdash;</dd>
        {
          showRates && (
            <dd class="calc__rate">
              {WORDS_PER_FINISHED_HOUR.toLocaleString('en-US')} words per finished hour
            </dd>
          )
        }
      </div>
      {/* No standalone Rate figure: as an output it read like a fixed price.
          The per-finished-hour numbers stay inside the toggle segments, where
          they anchor the estimate without being presented as the quote. */}
      <div class="calc__figure calc__figure--total">
        <dt class="calc__key">Starting estimate</dt>
        <dd class="calc__total" data-total aria-live="polite">&mdash;</dd>
        {
          showRates && (
            <dd class="calc__rate">
              at <span data-rate>${defaultService.rate}</span> per finished hour
            </dd>
          )
        }
      </div>
    </dl>

    <p class="calc__note" id="calc-note">{ESTIMATE_DISCLAIMER}</p>
    <p class="calc__terms">{ARRANGEMENTS_NOTE}</p>

    <button class="btn btn--primary" type="button" data-handoff>Send this to Victoria</button>
  </div>
</div>

<script type="application/json" data-calc-config set:html={JSON.stringify(config)} />

<style>
  .calc {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3);
  }

  .calc__controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .calc__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .calc__legend {
    margin: 0;
    font-family: var(--font-body);
    color: var(--c-text-caption);
  }

  /* Segmented control as two boxes. The selected box is hunter with the
     chip's gold underline: green as state, never as the action. */
  .seg {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .seg__btn {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    background: transparent;
    border: 1px solid var(--c-card-edge);
    border-radius: 12px;
    color: var(--c-text-card);
    cursor: pointer;
    font-family: var(--font-body);
    text-align: left;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }

  .seg__btn:hover {
    border-color: var(--c-emerald);
    color: var(--c-text-body);
  }

  .seg__btn[aria-pressed='true'] {
    background: var(--c-hunter);
    border-color: var(--c-emerald);
    box-shadow: inset 0 -3px 0 var(--c-accent);
    color: var(--c-text-body);
  }

  .seg__name {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .seg__meta {
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--c-text-caption);
  }

  .calc__desc {
    max-width: 68ch;
    color: var(--c-text-card);
    font-size: 14px;
    line-height: 1.6;
  }

  .calc__input {
    width: 100%;
    max-width: 320px;
    min-height: 48px;
    padding: 12px 14px;
    background: var(--c-deep);
    border: 1px solid var(--c-card-edge);
    border-radius: var(--radius-btn);
    color: var(--c-text-body);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-variant-numeric: tabular-nums;
  }

  .calc__input:focus-visible {
    border-color: var(--c-accent);
  }

  /* Slider: emerald-to-gold fill up to the thumb, via --fill set from JS. */
  .calc__range {
    --fill: 57%;
    width: 100%;
    height: 24px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
  }

  .calc__range::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background:
      linear-gradient(90deg, var(--c-emerald), var(--c-accent)) 0 0 / var(--fill) 100% no-repeat,
      var(--c-card-edge);
  }

  .calc__range::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background:
      linear-gradient(90deg, var(--c-emerald), var(--c-accent)) 0 0 / var(--fill) 100% no-repeat,
      var(--c-card-edge);
  }

  .calc__range::-webkit-slider-thumb {
    width: 20px;
    height: 20px;
    margin-top: -8px;
    border: 2px solid var(--c-deep);
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 10px var(--c-gold-glow);
    appearance: none;
  }

  .calc__range::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 2px solid var(--c-deep);
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 10px var(--c-gold-glow);
  }

  .calc__scale {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--c-text-caption);
  }

  .calc__out {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--c-rule);
  }

  .calc__figures {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }

  .calc__figure {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .calc__key {
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-text-caption);
  }

  .calc__val {
    margin: 0;
    color: var(--c-text-body);
    font-family: var(--font-display);
    font-size: 30px;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .calc__total {
    margin: 0;
    color: var(--c-accent);
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 400;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .calc__rate {
    margin: 0;
    font-size: 13px;
    color: var(--c-text-caption);
  }

  .calc__note {
    max-width: 68ch;
    /* Quiet grey, which clears AA on every surface it sits on. */
    color: var(--c-quiet);
    font-size: 13px;
    line-height: 1.6;
  }

  /* One step up from the disclaimer: this one is an invitation, not a caveat. */
  .calc__terms {
    max-width: 68ch;
    margin-top: var(--space-1);
    padding-top: var(--space-1);
    border-top: 1px solid var(--c-rule);
    color: var(--c-text-card);
    font-size: 13px;
    line-height: 1.6;
  }

  .calc [data-handoff] {
    align-self: flex-start;
  }

  @media (min-width: 700px) {
    .seg {
      grid-template-columns: 1fr 1fr;
    }

    .calc__figure--total {
      margin-left: auto;
      align-items: flex-end;
    }
  }
</style>

<script>
  interface ServiceOption {
    id: string;
    name: string;
    qualifier: string;
    rate: number;
    description: string;
  }

  const root = document.querySelector<HTMLElement>('[data-calc]');
  const configEl = document.querySelector<HTMLScriptElement>('[data-calc-config]');

  if (root && configEl) {
    const config: {
      services: ServiceOption[];
      wordsPerHour: number;
      formTarget: string;
      range: { min: number; max: number; step: number };
    } = JSON.parse(configEl.textContent || '{}');

    const input = root.querySelector<HTMLInputElement>('[data-words]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const descEl = root.querySelector<HTMLElement>('[data-desc]')!;
    const hoursEl = root.querySelector<HTMLElement>('[data-hours]')!;
    const totalEl = root.querySelector<HTMLElement>('[data-total]')!;
    const handoff = root.querySelector<HTMLButtonElement>('[data-handoff]')!;
    const segButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-service]')];
    const range = root.querySelector<HTMLInputElement>('[data-range]');
    const rateEl = root.querySelector<HTMLElement>('[data-rate]');

    const group = new Intl.NumberFormat('en-US');
    const usd = new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0,
    });

    let service = config.services[0];
    let words = 0;

    /** Reformat with thousands separators while holding the caret in place. */
    function formatInput() {
      const raw = input.value;
      const caret = input.selectionStart ?? raw.length;
      const digitsBeforeCaret = raw.slice(0, caret).replace(/\D/g, '').length;

      // Strips commas from a paste as readily as it ignores stray characters.
      const digits = raw.replace(/\D/g, '').replace(/^0+(?=\d)/, '').slice(0, 9);
      const formatted = digits ? group.format(Number(digits)) : '';
      input.value = formatted;

      let pos = 0;
      let seen = 0;
      while (pos < formatted.length && seen < digitsBeforeCaret) {
        if (formatted.charCodeAt(pos) >= 48 && formatted.charCodeAt(pos) <= 57) seen++;
        pos++;
      }
      input.setSelectionRange(pos, pos);

      return digits ? Number(digits) : 0;
    }

    const DASH = '—';

    /** Exact hours. Never rounded — rounding here compounds into the total. */
    const rawHours = (n: number) => n / config.wordsPerHour;

    /** Rounding happens at display time only, never on a value feeding a sum. */
    function formatHours(exact: number) {
      // Below a tenth of an hour, "0.0" reads as nothing at all.
      if (exact < 0.1) return '<0.1';
      return (Math.round(exact * 10) / 10).toFixed(1);
    }

    function render() {
      if (!words || words <= 0) {
        hoursEl.textContent = DASH;
        totalEl.textContent = DASH;
        return;
      }

      const exact = rawHours(words);
      hoursEl.textContent = formatHours(exact);
      totalEl.textContent = usd.format(Math.round(exact * service.rate));
    }

    function selectService(next: ServiceOption) {
      service = next;
      for (const b of segButtons) {
        b.setAttribute('aria-pressed', String(b.dataset.service === next.id));
      }
      descEl.textContent = next.description;
      if (rateEl) rateEl.textContent = usd.format(next.rate);
      render();
    }

    /** Keep the slider and its fill in step with `words` (clamped to its bounds). */
    function syncRange() {
      if (!range) return;
      if (words > 0) {
        range.value = String(Math.min(config.range.max, Math.max(config.range.min, words)));
      }
      const pct =
        ((Number(range.value) - config.range.min) / (config.range.max - config.range.min)) * 100;
      range.style.setProperty('--fill', `${pct}%`);
    }

    input.addEventListener('input', () => {
      words = formatInput();
      render();
      syncRange();
    });

    range?.addEventListener('input', () => {
      words = Number(range.value);
      input.value = group.format(words);
      render();
      syncRange();
    });

    for (const button of segButtons) {
      button.addEventListener('click', () => {
        const next = config.services.find((s) => s.id === button.dataset.service);
        if (next) selectService(next);
      });
    }

    // Arrow keys move between segments and select as they go.
    root.querySelector<HTMLElement>('[data-seg]')!.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key !== 'ArrowLeft' && key !== 'ArrowRight' && key !== 'ArrowUp' && key !== 'ArrowDown') return;
      e.preventDefault();
      const i = segButtons.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const step = key === 'ArrowRight' || key === 'ArrowDown' ? 1 : -1;
      const next = segButtons[(i + step + segButtons.length) % segButtons.length];
      next.focus();
      next.click();
    });

    const MARKER = 'Quote estimate:';

    handoff.addEventListener('click', () => {
      const section = document.getElementById(config.formTarget);

      // No form on this page (Home): carry the estimate to the contact page,
      // whose calculator reads it back from the query string on load.
      if (!section) {
        const params = new URLSearchParams({ service: service.id });
        if (words > 0) params.set('words', String(words));
        window.location.href = `/contact?${params}`;
        return;
      }
      const wordField = document.querySelector<HTMLInputElement>('#wordCount');
      const notes = document.querySelector<HTMLTextAreaElement>('#notes');

      // No valid count: scroll only, prefill nothing.
      const hasEstimate = words > 0;

      if (hasEstimate && wordField) wordField.value = String(words);

      if (hasEstimate && notes) {
        const exact = rawHours(words);
        const line =
          `${MARKER} ${service.name} (${service.qualifier}) — ${group.format(words)} words, ` +
          `about ${formatHours(exact)} finished hours at ${usd.format(service.rate)}/hr, ` +
          `roughly ${usd.format(Math.round(exact * service.rate))}.`;

        // Replace a previous estimate rather than stacking them up; anything
        // the visitor typed themselves is left untouched.
        const kept = notes.value
          .split('\n')
          .filter((l) => !l.startsWith(MARKER))
          .join('\n')
          .trim();
        notes.value = kept ? `${kept}\n\n${line}` : line;
      }

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      section?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      // preventScroll so focusing doesn't fight the smooth scroll.
      wordField?.focus({ preventScroll: true });
    });

    // Arrival with an estimate from another page (?words=&service=), else
    // whatever the server pre-filled.
    const incoming = new URLSearchParams(window.location.search);
    const incomingService = config.services.find((s) => s.id === incoming.get('service'));
    if (incomingService) service = incomingService;
    const incomingWords = Number(incoming.get('words'));
    if (incomingWords > 0) input.value = String(incomingWords);
    if (input.value) words = formatInput();

    selectService(service);
    syncRange();
  }
</script>
