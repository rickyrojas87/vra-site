---
/**
 * Site header (artboard .nav): a plain row inside each page's hero, over the
 * video or poster — not sticky, no background, no border. Rendered by
 * Hero.astro, PageHero.astro and the Thanks page, not by BaseLayout, so it
 * sits inside the hero's container exactly as drawn.
 *
 * The artboard simply hides the links under 900px; this keeps a toggle and a
 * drawer there so the pages stay reachable on phones.
 */
import logoHorizontal from '../assets/logos/logo-horizontal.svg?raw';
import { decorativeSvg } from '../utils/logo';

const logo = decorativeSvg(logoHorizontal);

const nav = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Works', href: '/works' },
  { label: 'Contact', href: '/contact' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="nav">
  <a class="wordmark" href="/" aria-label="Victoria Rojas Audio, home"><Fragment set:html={logo} /></a>

  <nav class="nav-links" aria-label="Main">
    {
      nav.map((item) => (
        <a
          class:list={{ on: isActive(item.href) }}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <a class="btn btn--bookplate nav__cta" href="/contact">Request a quote</a>

  <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
    <span class="visually-hidden">Menu</span>
    <span class="nav__toggle-bar" aria-hidden="true"></span>
    <span class="nav__toggle-bar" aria-hidden="true"></span>
  </button>

  <div class="nav__drawer" id="mobile-nav" hidden>
    <nav class="nav__drawer-links" aria-label="Main, mobile">
      {
        nav.map((item) => (
          <a
            class:list={{ on: isActive(item.href) }}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a class="btn btn--bookplate" href="/contact">Request a quote</a>
  </div>
</header>

<style>
  .nav {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
  }

  .wordmark {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  /* Injected markup carries no scope attribute, hence :global. The file's own
     fill="#D4AF37" is a presentation attribute, so this rule wins over it. */
  .wordmark :global(svg) {
    display: block;
    width: auto;
    height: 44px;
    fill: var(--c-text);
    transition: fill 200ms ease;
  }

  .wordmark:hover :global(svg) {
    fill: var(--c-accent);
  }

  .nav-links {
    display: flex;
    gap: 34px;
  }

  .nav-links a,
  .nav__drawer-links a {
    font-size: 14px;
    letter-spacing: 0.08em;
    color: var(--c-muted);
    transition: color 200ms ease;
  }

  .nav-links a:hover,
  .nav-links a.on,
  .nav__drawer-links a:hover,
  .nav__drawer-links a.on {
    color: var(--c-accent);
  }

  .nav__cta {
    min-height: 44px;
    padding: 0 20px;
    font-size: 12px;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .nav__toggle-bar {
    display: block;
    width: 24px;
    height: 1px;
    margin-inline: auto;
    background: var(--c-text);
  }

  /* Drops over the hero from under the row; the hero content stays put. */
  .nav__drawer {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2) var(--space-3);
    border-radius: 16px;
    background: var(--c-deep);
    box-shadow:
      0 20px 50px rgb(0 0 0 / 50%),
      inset 0 0 0 1px rgb(184 146 90 / 35%);
  }

  .nav__drawer[hidden] {
    display: none;
  }

  .nav__drawer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  @media (max-width: 900px) {
    .nav {
      padding: 16px 0;
    }

    .nav-links,
    .nav__cta {
      display: none;
    }

    .nav__toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const drawer = document.querySelector<HTMLElement>('#mobile-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (drawer) drawer.hidden = open;
  });
</script>
