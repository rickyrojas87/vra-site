---
/** Spec section 2. Sticky, 88px desktop / 64px mobile. No Instagram icon — it lives in the Footer. */
import logoHorizontal from '../assets/logos/logo-horizontal.svg?raw';
import { decorativeSvg } from '../utils/logo';

const logo = decorativeSvg(logoHorizontal);

const nav = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Works', href: '/works' },
  { label: 'Contact', href: '/contact' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="header">
  <div class="header__inner">
    <a class="wordmark" href="/" aria-label="Victoria Rojas"><Fragment set:html={logo} /></a>

    <nav class="nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            class:list={['nav__link', { 'is-active': isActive(item.href) }]}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="btn btn--outline header__cta" href="/contact">Request a quote</a>

    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="visually-hidden">Menu</span>
      <span class="header__toggle-bar" aria-hidden="true"></span>
      <span class="header__toggle-bar" aria-hidden="true"></span>
    </button>
  </div>

  <div class="header__drawer" id="mobile-nav" hidden>
    <nav class="drawer__nav" aria-label="Primary, mobile">
      {
        nav.map((item) => (
          <a
            class:list={['nav__link', { 'is-active': isActive(item.href) }]}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a class="btn btn--outline" href="/contact">Request a quote</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--c-header-bg);
    border-bottom: 1px solid var(--c-rule);
    backdrop-filter: blur(10px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    max-width: var(--max-width);
    height: var(--header-h);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* The lockup, never a photo. 32px in the 64px bar, 44px in the 88px one —
     both leave 16px of clear space above and below, and neither changes
     --header-h. Width follows from the 2265x571 viewBox: 127px and 175px, both
     narrower than the 210px text wordmark this replaced, so the nav gained
     room rather than losing it. */
  .wordmark {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    --logo-h: 32px;
  }

  /* Injected markup carries no scope attribute, hence :global. The file's own
     fill="#D4AF37" is a presentation attribute, so this rule wins over it and
     every path inherits — one place controls the colour. */
  .wordmark :global(svg) {
    display: block;
    height: var(--logo-h);
    width: auto;
    fill: var(--c-text);
    transition: fill 200ms ease;
  }

  /* Bronze, matching .nav__link:hover. Gold here would read as a second
     active state next to the CTA border. */
  .wordmark:hover :global(svg) {
    fill: var(--c-accent-2);
  }

  .nav {
    display: none;
    gap: var(--space-3);
  }

  .nav__link {
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--c-muted);
    transition: color 200ms ease;
  }

  .nav__link:hover {
    color: var(--c-accent-2);
  }

  .nav__link.is-active {
    color: var(--c-accent);
  }

  .header__cta {
    display: none;
    min-height: 40px;
    padding: 0 22px;
  }

  .header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .header__toggle-bar {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--c-text);
  }

  .header__drawer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2) var(--gutter) var(--space-3);
    border-top: 1px solid var(--c-rule);
    background: var(--c-bg);
  }

  .header__drawer[hidden] {
    display: none;
  }

  .drawer__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  /* Follows --header-h, which steps up at 768px — not the 900px nav
     breakpoint. Keyed to 900 the lockup would sit at 32px inside an 88px bar
     for that whole band. */
  @media (min-width: 768px) {
    .wordmark {
      --logo-h: 44px;
    }
  }

  @media (min-width: 900px) {
    .nav,
    .header__cta {
      display: flex;
    }

    .header__toggle,
    .header__drawer {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const drawer = document.querySelector<HTMLElement>('#mobile-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (drawer) drawer.hidden = open;
  });
</script>
