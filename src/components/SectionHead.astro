---
/**
 * Section opening (artboard .label + .h2): chapter eyebrow, then the title.
 * Left-aligned by default; `center` for the shelf. The default slot is the
 * title's content, so it can carry an <em> accent.
 *
 * The gold thread is NOT here: it pins to the top of the section itself, so
 * each section renders <GoldThread /> as its own first child.
 */
import Eyebrow from './Eyebrow.astro';

interface Props {
  chapter?: number;
  label: string;
  align?: 'start' | 'center';
  /** Heading id, for aria-labelledby on the section. */
  id?: string;
  class?: string;
}

const { chapter, label, align = 'start', id, class: extraClass } = Astro.props;
---

<header class:list={['section-head', { 'section-head--center': align === 'center' }, extraClass]}>
  <Eyebrow chapter={chapter} label={label} />
  <h2 class="section-title" id={id}><slot /></h2>
</header>
