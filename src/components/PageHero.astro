---
/**
 * Short hero for About, Works and Contact (spec v2 §5): the Home title page
 * without the video, the booking badge or the photo. The library poster sits
 * still behind it, under the same lamp, green glow and scrim, with dust.
 *
 * The poster is the same responsive image as Home's (utils/heroPoster.ts), so
 * a visitor arriving from Home already has it cached. Pair it with
 * <PosterPreload slot="head" /> on the page; it is the LCP candidate.
 *
 * Not revealed, for the same reason as the Home hero: it holds the LCP
 * element.
 */
import Dust from './Dust.astro';
import { getHeroPoster } from '../utils/heroPoster';

interface Props {
  eyebrow: string;
  title: string;
  /** Handwritten line under the title, in La Belle Aurore. */
  subline: string;
  /** Optional plain line under the closing rules. */
  lede?: string;
}

const { eyebrow, title, subline, lede } = Astro.props;
const poster = await getHeroPoster();
---

<section class="page-hero">
  <div class="page-hero__media" aria-hidden="true">
    <img
      class="page-hero__poster"
      src={poster.src}
      srcset={poster.srcSet.attribute}
      sizes={poster.attributes.sizes}
      width={poster.attributes.width}
      height={poster.attributes.height}
      alt=""
      decoding="async"
      fetchpriority="high"
    />
    <div class="page-hero__lamp"></div>
    <div class="page-hero__scrim"></div>
  </div>

  <Dust seed={title.length * 7} count={18} />

  <div class="container page-hero__page">
    <span class="page-hero__rules" aria-hidden="true"></span>
    <p class="page-hero__eyebrow">{eyebrow}</p>
    <h1 class="page-hero__title">{title}</h1>
    <p class="hand hand--bright page-hero__subline">{subline}</p>
    <span class="page-hero__rules" aria-hidden="true"></span>
    {lede && <p class="lede page-hero__lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(560px, 70svh);
    padding-block: var(--space-4) calc(var(--space-4) + 24px);
    overflow: hidden;
    background: var(--c-deep);
  }

  .page-hero__media,
  .page-hero__media > * {
    position: absolute;
    inset: 0;
  }

  .page-hero__media {
    z-index: -1;
  }

  .page-hero__poster {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    filter: brightness(0.6) saturate(0.95) blur(0.6px);
    transform: scale(1.02);
  }

  /* Still lamplight: the flicker belongs to the Home video. */
  .page-hero__lamp {
    background:
      radial-gradient(ellipse 45% 60% at 20% 20%, rgb(230 200 94 / 18%), transparent 70%),
      radial-gradient(ellipse 70% 50% at 50% 105%, rgb(63 140 100 / 24%), transparent 70%);
    mix-blend-mode: screen;
  }

  /* Holds contrast for the type, then hands off to the deep section below. */
  .page-hero__scrim {
    background:
      linear-gradient(to bottom, transparent 55%, var(--c-deep)),
      radial-gradient(ellipse 60% 70% at 50% 50%, rgb(18 19 22 / 70%), rgb(18 19 22 / 40%));
  }

  .page-hero__page {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .page-hero__rules {
    display: block;
    width: min(280px, 60%);
    height: 5px;
    border-block: 1px solid var(--c-accent);
    opacity: 0.8;
  }

  .page-hero__eyebrow {
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--c-text-caption);
  }

  .page-hero__title {
    font-size: var(--fs-page-title);
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--c-text-body);
  }

  /* Fixed, full-width line box so the handwriting face's late swap can't
     shift layout: as a centred inline-block its box narrowed on swap (CLS). */
  .page-hero__subline {
    display: block;
    align-self: stretch;
    height: 1.3em;
    font-size: var(--fs-subline);
  }

  .page-hero__lede {
    margin-top: var(--space-1);
  }
</style>
