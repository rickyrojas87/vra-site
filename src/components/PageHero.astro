---
/**
 * Short hero for About, Works and Contact (artboard section.hero.hero-short):
 * a centred title page over the still library poster — gold rules, the page
 * name and a handwritten line. No video, badge, photo or buttons.
 *
 * The poster is the same responsive image as Home's (utils/heroPoster.ts), so
 * a visitor arriving from Home already has it cached. Pair it with
 * <HeroPreloads slot="head" /> on the page; it is the LCP candidate.
 *
 * Not revealed, for the same reason as the Home hero: it holds the LCP
 * element.
 */
import Header from './Header.astro';
import Dust from './Dust.astro';
import { getHeroPoster } from '../utils/heroPoster';

interface Props {
  title: string;
  /** Handwritten line under the title, in La Belle Aurore. */
  subline: string;
}

const { title, subline } = Astro.props;
const poster = await getHeroPoster();
---

<section class="page-hero">
  <div class="page-hero__media" aria-hidden="true">
    <img
      class="page-hero__poster"
      src={poster.src}
      srcset={poster.srcSet.attribute}
      sizes={poster.attributes.sizes}
      width={poster.attributes.width}
      height={poster.attributes.height}
      alt=""
      decoding="async"
      fetchpriority="high"
    />
    <div class="page-hero__glow"></div>
    <div class="page-hero__glow-green"></div>
    <div class="page-hero__scrim"></div>
  </div>

  <Dust seed={title.length * 7} count={18} />

  <div class="container">
    <Header />
    <div class="page-hero__page">
      <div class="rule rule-a rule-a--first" aria-hidden="true"></div>
      <div class="rule rule-b" aria-hidden="true"></div>
      <h1 class="page-hero__title">{title}</h1>
      <p class="hand page-hero__subline">{subline}</p>
      <div class="rule rule-b rule-b--closing" aria-hidden="true"></div>
      <div class="rule rule-a" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    padding-bottom: 70px;
    overflow: hidden;
    background: var(--c-deep);
  }

  .page-hero__media,
  .page-hero__media > * {
    position: absolute;
    inset: 0;
  }

  .page-hero__media {
    z-index: -1;
  }

  .page-hero__poster {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    filter: brightness(0.62) saturate(0.95) blur(0.8px);
    transform: scale(1.03);
  }

  /* Warm lamplight upper left, flickering (artboard .glow). */
  .page-hero__glow {
    background: radial-gradient(ellipse 55% 60% at 24% 30%, rgb(255 168 76 / 18%), rgb(255 168 76 / 0%) 60%);
    mix-blend-mode: screen;
    animation: lamp-flicker 5.5s ease-in-out infinite;
  }

  .page-hero__glow-green {
    background: radial-gradient(ellipse 50% 55% at 82% 72%, rgb(31 77 58 / 55%), rgb(31 77 58 / 0%) 70%);
  }

  /* Artboard .scrim: dark at the left, and down into the page at the foot. */
  .page-hero__scrim {
    background:
      linear-gradient(90deg, rgb(18 15 12 / 94%) 0%, rgb(18 15 12 / 72%) 42%, rgb(18 15 12 / 28%) 100%),
      linear-gradient(180deg, rgb(18 15 12 / 55%) 0%, rgb(18 15 12 / 0%) 22%, rgb(34 35 40 / 0%) 70%, var(--c-bg) 100%);
  }

  .page-hero__page {
    position: relative;
    z-index: 4;
    padding-block: 56px 10px;
    text-align: center;
  }

  .rule-b--closing {
    margin-top: 26px;
  }

  .page-hero__title {
    margin: 26px 0 0;
    font-family: var(--font-display);
    font-size: 64px;
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--c-text-body);
  }

  /* `font-display: optional` and inlined (HeroPreloads): the face is either
     there at first paint or never swapped in, so this line cannot shift. */
  .page-hero__subline {
    margin-top: 22px;
    font-size: 40px;
    line-height: 1.1;
    text-shadow: 0 0 24px rgb(212 175 55 / 35%);
  }

  @keyframes lamp-flicker {
    0%,
    100% {
      opacity: 0.9;
    }

    22% {
      opacity: 1;
    }

    38% {
      opacity: 0.82;
    }

    55% {
      opacity: 0.97;
    }

    71% {
      opacity: 0.86;
    }
  }

  @media (max-width: 900px) {
    .page-hero__title {
      font-size: 46px;
    }
  }

  @media (max-width: 560px) {
    .page-hero__title {
      line-height: 1.02;
      letter-spacing: 0.08em;
    }
  }
</style>
