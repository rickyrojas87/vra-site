---
/**
 * The listening room (artboard section.room) — Home 01 and Works 01. One
 * instance per page.
 *
 * Nothing audio-related is fetched until the user presses play. The 88 stage
 * bars are drawn from precomputed envelopes in src/data/peaks (see
 * `npm run peaks`), so every waveform is visible, seekable and measurable at
 * zero network cost. The MP3 is requested on first play of that track and
 * never before.
 *
 * Tracks and genre chips both derive from the Titles collection, so the filter
 * list cannot drift from the data. A title with no peak file — meaning no
 * sample MP3 — is absent from the player entirely.
 */
import { getImage } from 'astro:assets';
import { loadTitles } from '../utils/content';
import SectionHead from './SectionHead.astro';
import GoldThread from './GoldThread.astro';

/** Demos run minutes, not hours — mm:ss. */
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

interface Props {
  id?: string;
  chapter: number;
  eyebrow?: string;
  /** Title HTML; the <em> carries the gold italic. */
  title?: string;
  /**
   * Home: the stage also shows the Audible rating and a "Listen on Audible"
   * link. The Works artboard leaves both out (its catalog below carries them).
   */
  details?: boolean;
  /** Extra section classes. */
  class?: string;
}

const {
  id = 'demos',
  chapter,
  eyebrow = 'The listening room',
  title = 'Press play. <em>Stay for the story.</em>',
  details = true,
  class: extraClass,
} = Astro.props;

/** Peak envelopes, keyed by MP3 basename. */
const peakModules = import.meta.glob<{
  default: { duration: number; samples: number; peaks: number[] };
}>('../data/peaks/*.json', { eager: true });

const peaksByName = new Map(
  Object.entries(peakModules).map(([path, mod]) => [
    path.split('/').pop()!.replace('.json', ''),
    mod.default,
  ]),
);

/** A peak envelope reduced to `n` bars, each the loudest point in its slice. */
const bucket = (peaks: number[], n: number) =>
  Array.from({ length: n }, (_, i) => {
    const from = Math.floor((i / n) * peaks.length);
    const to = Math.max(from + 1, Math.floor(((i + 1) / n) * peaks.length));
    return Math.max(0, ...peaks.slice(from, to));
  });

/** Stage bars: 88, 14–114px tall in a 120px row (artboard .bars). */
const STAGE_BARS = 88;
const barHeight = (v: number) => Math.round(14 + 100 * v);

/** "9 hrs 54 min", the artboard's runtime format. */
function runtime(hours: number) {
  const h = Math.floor(hours);
  const m = Math.round((hours - h) * 60);
  const hrs = h ? `${h} hr${h === 1 ? '' : 's'}` : '';
  return [hrs, m ? `${m} min` : ''].filter(Boolean).join(' ');
}

const entries = (await loadTitles()).sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const tracks = (
  await Promise.all(
    entries.map(async (entry) => {
      const d = entry.data;
      const audio = d.sampleAudio;
      if (!audio) return null;
      const peaks = peaksByName.get(audio.split('/').pop()!.replace('.mp3', ''));
      // No envelope means no sample shipped: leave the title out of the player.
      if (!peaks) return null;
      // A track needs a peak file AND clearance: published titles are cleared
      // by definition, an unreleased one only once `samplePublic` says so.
      if (d.status !== 'published' && !d.samplePublic) return null;

      const inProduction = d.status === 'in-production';
      const [stage, thumb] = d.coverImage
        ? await Promise.all([
            getImage({ src: d.coverImage, width: 168, height: 168, densities: [1, 2], fit: 'cover' }),
            getImage({ src: d.coverImage, width: 52, height: 52, densities: [1, 2], fit: 'cover' }),
          ])
        : [undefined, undefined];

      return {
        id: entry.id,
        title: d.title,
        genre: d.genre ?? null,
        author: d.author ?? null,
        runtime: inProduction ? 'In production' : d.runtimeHours ? runtime(d.runtimeHours) : null,
        rating: inProduction
          ? 'Coming soon'
          : d.audibleRating !== undefined
            ? `${d.audibleRating.toFixed(1)} on Audible${
                d.ratingCount ? ` (${d.ratingCount} rating${d.ratingCount === 1 ? '' : 's'})` : ''
              }`
            : 'Not yet rated',
        audibleUrl: inProduction ? null : (d.audibleUrl ?? null),
        cover: stage ? { src: stage.src, srcset: stage.srcSet.attribute } : null,
        thumb: thumb ? { src: thumb.src, srcset: thumb.srcSet.attribute } : null,
        src: audio,
        duration: peaks.duration,
        bars: bucket(peaks.peaks, STAGE_BARS).map(barHeight),
      };
    }),
  )
).filter((t): t is NonNullable<typeof t> => t !== null);

const first = tracks[0];

/** Chips come from the tracks actually in the player, never a hand-written list. */
const genres = [...new Set(tracks.map((t) => t.genre).filter((g): g is string => Boolean(g)))].sort();

/** Deterministic 0–1 noise (the artboard's `seeded`), so builds are stable. */
const seeded = (i: number, s: number) => {
  const x = Math.sin(i * 12.9898 + s * 78.233) * 43758.5453;
  return x - Math.floor(x);
};

const stageDelays = Array.from({ length: STAGE_BARS }, (_, i) => (seeded(i, 3) * 1.6).toFixed(2));

/**
 * Ambient wave band (artboard .wave-band): 160 bars rising from the floor,
 * every fourth shown on phones. Heights follow the first track's real
 * envelope, 20–90px, so the decoration is the sound of the player above it.
 */
const band = bucket(
  first ? (peaksByName.get(first.src.split('/').pop()!.replace('.mp3', ''))?.peaks ?? []) : [],
  160,
).map((v, j) => ({
  height: Math.round(20 + 70 * v),
  delay: (seeded(j, 11) * 2.6).toFixed(2),
  duration: (2 + seeded(j, 5) * 1.6).toFixed(2),
}));

const playIcon = 'M7 4.5v15l13-7.5z';
const pauseIcon = 'M6 4h4v16H6zM14 4h4v16h-4z';
---

{
  first && (
    <section class:list={['section', 'room', extraClass]} id={id}>
      <div class="wave-band" aria-hidden="true">
        {band.map((b) => (
          <span style={`height:${b.height}px;animation-delay:${b.delay}s;animation-duration:${b.duration}s`} />
        ))}
      </div>
      <GoldThread />

      <div class="container room__wrap" data-player>
        <SectionHead chapter={chapter} label={eyebrow}>
          <Fragment set:html={title} />
        </SectionHead>

        <div class="filters" role="group" aria-label="Filter demos by genre">
          <button class="chip" type="button" data-genre="all" aria-pressed="true">
            All
          </button>
          {genres.map((genre) => (
            <button class="chip" type="button" data-genre={genre} aria-pressed="false">
              {genre}
            </button>
          ))}
        </div>

        <div class="room-grid reveal">
          <div class="stage" data-stage>
            <div class="stage-top">
              {first.cover ? (
                <img
                  class="stage-cover"
                  src={first.cover.src}
                  srcset={first.cover.srcset}
                  alt={`Cover of ${first.title}`}
                  width="168"
                  height="168"
                  loading="lazy"
                  fetchpriority="low"
                  decoding="async"
                  data-cover
                />
              ) : null}
              <div>
                <p class="stage-genre" data-genre-label>
                  {first.genre ? `${first.genre} demo` : 'Demo'}
                </p>
                <h3 data-title>{first.title}</h3>
                <div class="meta" data-byline>
                  {[first.author && `by ${first.author}`, first.runtime].filter(Boolean).join(' · ')}
                </div>
                {details && (
                  <div class="meta stage-rating">
                    <span class="star" aria-hidden="true">
                      &#9733;
                    </span>{' '}
                    <span data-rating>{first.rating}</span>
                  </div>
                )}
              </div>
            </div>

            <div
              class="bars"
              data-bars
              role="slider"
              tabindex="0"
              aria-label="Seek within the demo"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              aria-valuetext="0%"
            >
              {first.bars.map((h, i) => (
                <span style={`height:${h}px;animation-delay:${stageDelays[i]}s`} />
              ))}
            </div>

            <div class="transport">
              <button class="play" type="button" data-toggle aria-label="Play demo">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path class="play__icon-play" d={playIcon} />
                  <path class="play__icon-pause" d={pauseIcon} />
                </svg>
              </button>
              <div class="time">
                <span data-elapsed>0:00</span> / <span data-total>{mmss(first.duration)}</span>
              </div>
              {details && (
                <a
                  class="stage-link"
                  href={first.audibleUrl ?? undefined}
                  target="_blank"
                  rel="noopener"
                  hidden={!first.audibleUrl}
                  data-link
                >
                  Listen on Audible &#8599;
                </a>
              )}
            </div>
          </div>

          <div class="list">
            {tracks.map((t, i) => (
              <button
                class="track"
                type="button"
                data-track={t.id}
                data-track-genre={t.genre ?? ''}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {t.thumb ? (
                  <img src={t.thumb.src} srcset={t.thumb.srcset} alt="" width="52" height="52" loading="lazy" fetchpriority="low" decoding="async" />
                ) : (
                  <span class="track-thumb" aria-hidden="true" />
                )}
                <span class="track-text">
                  <span class="track-t">{t.title}</span>
                  <span class="track-m">{[t.genre, t.author].filter(Boolean).join(' · ')}</span>
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<script type="application/json" data-tracks-json set:html={JSON.stringify(tracks)} />

<style>
  /* --- Section (artboard .room) -------------------------------------------- */

  .room {
    padding-block: 140px 300px;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 60% at 15% 0%, rgb(23 58 44 / 55%), rgb(23 58 44 / 0%) 70%),
      var(--c-deep);
  }

  .room__wrap {
    position: relative;
    z-index: 1;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 36px;
  }

  .room-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 32px;
    margin-top: 56px;
  }

  /* --- Stage --------------------------------------------------------------- */

  .stage {
    position: relative;
    overflow: hidden;
    padding: 36px;
    border-radius: var(--radius-card);
    background: linear-gradient(160deg, var(--c-panel) 0%, var(--c-panel-shade) 60%, var(--c-panel-green) 140%);
    box-shadow:
      0 30px 80px rgb(0 0 0 / 45%),
      inset 0 0 0 1px var(--c-card-edge);
  }

  .stage-top {
    display: flex;
    gap: 28px;
    align-items: center;
  }

  .stage-cover {
    display: block;
    flex: none;
    width: 168px;
    height: 168px;
    border-radius: 14px;
    object-fit: cover;
    box-shadow: 0 20px 40px rgb(0 0 0 / 55%);
    transition: transform 0.5s ease;
  }

  .stage-cover[hidden] {
    display: none;
  }

  .is-playing .stage-cover {
    transform: rotate(-2deg) scale(1.03);
  }

  .stage-genre {
    margin: 0;
    font-size: 13px;
    font-weight: var(--fw-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-emerald-glow);
  }

  .stage h3 {
    margin: 8px 0 6px;
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 400;
    line-height: 1.1;
  }

  .meta {
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--c-muted);
  }

  .stage-rating {
    margin-top: 6px;
  }

  .star {
    color: var(--c-accent);
  }

  .bars {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 120px;
    margin: 36px 0 18px;
    cursor: pointer;
    touch-action: none;
  }

  .bars span {
    flex: 1;
    border-radius: 2px;
    background: rgb(200 184 162 / 28%);
    transition: background 0.3s;
  }

  .bars span.on {
    background: var(--c-accent);
  }

  .is-playing .bars span {
    animation: pulsebar 1.6s ease-in-out infinite;
  }

  .transport {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    flex: none;
    border: 0;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 0 0 rgb(212 175 55 / 50%);
    color: var(--c-deep);
    cursor: pointer;
    transition: transform 0.2s;
  }

  .play:hover {
    transform: scale(1.06);
  }

  .is-playing .play {
    animation: ring 2s infinite;
  }

  .play__icon-pause,
  .is-playing .play__icon-play {
    display: none;
  }

  .is-playing .play__icon-pause {
    display: inline;
  }

  .time {
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--c-quiet);
    font-variant-numeric: tabular-nums;
  }

  .stage-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-left: auto;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .stage-link:hover {
    color: var(--c-text);
  }

  /* --- Track list ---------------------------------------------------------- */

  .list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .track {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 10px 14px 10px 10px;
    border: 0;
    border-radius: 14px;
    background: rgb(44 45 51 / 55%);
    box-shadow: inset 0 0 0 1px rgb(184 146 90 / 14%);
    color: var(--c-text);
    font-family: var(--font-body);
    text-align: left;
    cursor: pointer;
    transition:
      background 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }

  .track[hidden] {
    display: none;
  }

  .track:hover {
    transform: translateX(4px);
    box-shadow: inset 0 0 0 1px rgb(212 175 55 / 45%);
  }

  .track[aria-pressed='true'] {
    background: rgb(31 77 58 / 60%);
    box-shadow: inset 0 0 0 1px var(--c-emerald);
  }

  .track img,
  .track-thumb {
    display: block;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 8px;
    object-fit: cover;
  }

  .track-thumb {
    background: var(--c-hunter);
  }

  .track-text {
    display: flex;
    flex-direction: column;
  }

  .track-t {
    font-family: var(--font-display);
    font-size: 21px;
    line-height: 1.15;
  }

  .track-m {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--c-muted);
  }

  /* --- Ambient wave band --------------------------------------------------- */

  .wave-band {
    position: absolute;
    inset: auto 0 0;
    z-index: 0;
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 220px;
    opacity: 0.38;
    mask-image: linear-gradient(180deg, transparent 0, #000 55%);
    pointer-events: none;
  }

  .wave-band span {
    flex: 1;
    min-width: 2px;
    border-radius: 3px;
    background: linear-gradient(180deg, var(--c-accent), rgb(212 175 55 / 15%));
    transform-origin: bottom;
    animation: wave 2.6s ease-in-out infinite;
  }

  @keyframes wave {
    0%,
    100% {
      transform: scaleY(0.35);
    }

    50% {
      transform: scaleY(1);
    }
  }

  @keyframes pulsebar {
    0%,
    100% {
      transform: scaleY(1);
    }

    50% {
      transform: scaleY(0.72);
    }
  }

  @keyframes ring {
    0% {
      box-shadow: 0 0 0 0 rgb(212 175 55 / 50%);
    }

    100% {
      box-shadow: 0 0 0 22px rgb(212 175 55 / 0%);
    }
  }

  @media (max-width: 900px) {
    .room {
      padding-block: 110px 220px;
    }

    .room-grid {
      grid-template-columns: 1fr;
    }

    .stage-top {
      flex-direction: column;
      align-items: flex-start;
    }

    .bars {
      gap: 2px;
      height: 90px;
    }

    .bars span:nth-child(even),
    .wave-band span:not(:nth-child(4n + 1)) {
      display: none;
    }

    .transport {
      flex-wrap: wrap;
      gap: 14px;
    }
  }

  @media (max-width: 560px) {
    .stage {
      padding: 26px 20px;
    }

    .stage h3 {
      font-size: 32px;
    }

    .stage-cover {
      width: 132px;
      height: 132px;
    }
  }
</style>

<script>
  interface Track {
    id: string;
    title: string;
    genre: string | null;
    author: string | null;
    runtime: string | null;
    rating: string;
    audibleUrl: string | null;
    cover: { src: string; srcset: string } | null;
    src: string;
    duration: number;
    bars: number[];
  }

  const root = document.querySelector<HTMLElement>('[data-player]');
  const json = document.querySelector<HTMLScriptElement>('[data-tracks-json]');
  if (root && json) {
    const tracks: Track[] = JSON.parse(json.textContent || '[]');
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const barsEl = root.querySelector<HTMLElement>('[data-bars]')!;
    const bars = [...barsEl.children] as HTMLElement[];
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const elapsedEl = root.querySelector<HTMLElement>('[data-elapsed]')!;
    const totalEl = root.querySelector<HTMLElement>('[data-total]')!;
    const coverEl = root.querySelector<HTMLImageElement>('[data-cover]');
    const genreEl = root.querySelector<HTMLElement>('[data-genre-label]')!;
    const titleEl = root.querySelector<HTMLElement>('[data-title]')!;
    const bylineEl = root.querySelector<HTMLElement>('[data-byline]')!;
    const ratingEl = root.querySelector<HTMLElement>('[data-rating]');
    const linkEl = root.querySelector<HTMLAnchorElement>('[data-link]');
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-genre]')];
    const trackButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-track]')];

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    // One element for the whole player: starting a track inherently stops the last.
    const audio = new Audio();
    audio.preload = 'none';

    let current: Track = tracks[0];
    let progress = 0;
    let raf = 0;
    /** Bars currently lit; the DOM is touched only when this changes. */
    let lit = -1;
    /** id of the track whose MP3 is currently assigned to the element, if any. */
    let loadedId: string | null = null;
    /** Bumped on every select and play; retires stale deferred seeks. */
    let seekToken = 0;

    const mmss = (s: number) =>
      `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    /** Light the bars up to `progress` and keep the slider semantics in step. */
    function draw() {
      const on = Math.round(progress * bars.length);
      if (on !== lit) {
        bars.forEach((bar, i) => bar.classList.toggle('on', i < on));
        lit = on;
      }
      const pct = Math.round(progress * 100);
      barsEl.setAttribute('aria-valuenow', String(pct));
      barsEl.setAttribute('aria-valuetext', `${pct}%, ${mmss(progress * current.duration)}`);
    }

    /**
     * True only while the element actually holds the selected track's file.
     *
     * Every handler that writes `progress`, the readout or the bars must check
     * this first. `audio.pause()` flips `.paused` synchronously but queues the
     * `pause` EVENT as a task, so a frame or a `timeupdate` belonging to the
     * outgoing track can still land after select() has run — and would divide
     * the OLD currentTime by the NEW duration.
     */
    const isLive = () => loadedId === current.id;

    function tick() {
      if (!isLive()) return;
      if (current.duration) progress = audio.currentTime / current.duration;
      elapsedEl.textContent = mmss(audio.currentTime);
      draw();
      if (!audio.paused) raf = requestAnimationFrame(tick);
    }

    /** Reduced motion: repaint on timeupdate only, no per-frame loop. */
    function startLoop() {
      if (reduced.matches) return;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(tick);
    }

    /** Swap the stage to `track`: cover, labels, link and bar heights. */
    function showTrack(track: Track) {
      if (coverEl && track.cover) {
        coverEl.srcset = track.cover.srcset;
        coverEl.src = track.cover.src;
      }
      if (coverEl) {
        coverEl.alt = `Cover of ${track.title}`;
        coverEl.hidden = !track.cover;
      }
      genreEl.textContent = track.genre ? `${track.genre} demo` : 'Demo';
      titleEl.textContent = track.title;
      bylineEl.textContent = [track.author && `by ${track.author}`, track.runtime]
        .filter(Boolean)
        .join(' · ');
      if (ratingEl) ratingEl.textContent = track.rating;
      if (linkEl) {
        linkEl.hidden = !track.audibleUrl;
        if (track.audibleUrl) linkEl.href = track.audibleUrl;
      }
      bars.forEach((bar, i) => (bar.style.height = `${track.bars[i] ?? 14}px`));
    }

    /**
     * Selecting ANY track — including the one already loaded — rewinds to zero.
     *
     * The element is reused across tracks, so its currentTime outlives a
     * selection change. Three things have to move together or the readout, the
     * bars and the element drift apart: `progress` (what we draw), the elapsed
     * readout, and the element's own currentTime. Bumping `seekToken` also
     * retires any deferred seek still waiting on loadedmetadata, so a pre-play
     * seek from the previous selection can't land on the new track.
     */
    function select(track: Track) {
      seekToken++;

      // Kill the loop synchronously, BEFORE zeroing. Waiting for the `pause`
      // event to cancel it lets one more frame run and overwrite the reset.
      cancelAnimationFrame(raf);
      raf = 0;

      audio.pause();
      progress = 0;

      // Same file still in the element: rewind it now, so pressing play
      // resumes from the beginning rather than from where it was left.
      if (loadedId === track.id) {
        try {
          audio.currentTime = 0;
        } catch {
          /* not seekable yet; play() re-syncs from `progress` anyway */
        }
      }

      current = track;
      showTrack(track);
      totalEl.textContent = mmss(track.duration);
      elapsedEl.textContent = '0:00';
      for (const b of trackButtons) {
        b.setAttribute('aria-pressed', b.dataset.track === track.id ? 'true' : 'false');
      }
      stage.classList.remove('is-playing');
      toggle.setAttribute('aria-label', 'Play demo');
      draw();
    }

    function play() {
      const token = ++seekToken;
      const target = progress * current.duration;

      if (loadedId !== current.id) {
        // First play of this track is the first time its MP3 is ever requested.
        // Assigning src resets currentTime to 0 on its own.
        audio.src = current.src;
        loadedId = current.id;

        // Honour a seek made before the file existed: currentTime can only be
        // set once metadata has landed, so defer it rather than dropping it.
        // The token check retires this if the selection changed in between.
        if (target > 0) {
          audio.addEventListener(
            'loadedmetadata',
            () => {
              if (token !== seekToken) return;
              audio.currentTime = target;
            },
            { once: true },
          );
        }
      } else if (Math.abs(audio.currentTime - target) > 0.25) {
        // Already loaded. `progress` is the source of truth, so this covers both
        // a rewind from re-selecting and a seek made while paused; an untouched
        // pause/resume leaves the two within the threshold and simply resumes.
        audio.currentTime = target;
      }

      audio.play();
    }

    toggle.addEventListener('click', () => (audio.paused ? play() : audio.pause()));

    audio.addEventListener('play', () => {
      stage.classList.add('is-playing');
      toggle.setAttribute('aria-label', 'Pause demo');
      startLoop();
    });
    audio.addEventListener('pause', () => {
      stage.classList.remove('is-playing');
      toggle.setAttribute('aria-label', 'Play demo');
      cancelAnimationFrame(raf);
    });
    audio.addEventListener('ended', () => {
      if (!isLive()) return;
      progress = 0;
      elapsedEl.textContent = '0:00';
      draw();
    });
    audio.addEventListener('timeupdate', () => {
      if (!reduced.matches || !isLive()) return;
      if (current.duration) progress = audio.currentTime / current.duration;
      elapsedEl.textContent = mmss(audio.currentTime);
      draw();
    });

    for (const button of trackButtons) {
      button.addEventListener('click', () => {
        const track = tracks.find((t) => t.id === button.dataset.track);
        if (track) select(track); // Swaps the stage. Does not fetch audio.
      });
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const genre = chip.dataset.genre!;
        for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));

        let firstVisible: Track | null = null;
        for (const button of trackButtons) {
          const match = genre === 'all' || button.dataset.trackGenre === genre;
          button.hidden = !match;
          const track = tracks.find((t) => t.id === button.dataset.track)!;
          if (match && !firstVisible) firstVisible = track;
        }
        // If the selected track just got filtered out, stop and move to the first visible.
        const stillVisible = genre === 'all' || current.genre === genre;
        if (!stillVisible && firstVisible) select(firstVisible);
      });
    }

    function seekTo(clientX: number) {
      const rect = barsEl.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
      progress = ratio;
      // Only touch the element when it actually holds THIS track's file.
      if (loadedId === current.id) audio.currentTime = ratio * current.duration;
      elapsedEl.textContent = mmss(ratio * current.duration);
      draw();
    }

    barsEl.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      seekTo(e.clientX);
    });

    root.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      // Let Enter/Space work normally on the chips, tracks and links.
      if (e.key === ' ' && (target.tagName === 'BUTTON' || target.tagName === 'A')) return;

      if (e.key === ' ') {
        e.preventDefault();
        audio.paused ? play() : audio.pause();
      } else if ((e.key === 'ArrowRight' || e.key === 'ArrowLeft') && target === barsEl) {
        e.preventDefault();
        const delta = e.key === 'ArrowRight' ? 5 : -5;
        const next = Math.min(current.duration, Math.max(0, progress * current.duration + delta));
        progress = current.duration ? next / current.duration : 0;
        if (loadedId === current.id) audio.currentTime = next;
        elapsedEl.textContent = mmss(next);
        draw();
      }
    });

    if (tracks.length) select(tracks[0]);
  }
</script>
