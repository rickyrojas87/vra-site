---
/**
 * Staggered photo collage.
 *
 * Four columns, with columns 2 and 4 dropped so the top edge zigzags rather than
 * ruling a straight line. The offset is `margin-top`, not `transform`, so the
 * grid still reserves the space and nothing overflows the section.
 *
 * Driven by the `gallery` content collection — one file per photo, so the CMS
 * can add, remove and reorder without anyone editing this file. Renders nothing
 * at all below GALLERY_MIN entries.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

interface Props {
  heading?: string;
  surface?: 'base' | 'deep' | 'panel';
}

const { heading = 'In the booth', surface = 'panel' } = Astro.props;

/** A partial row breaks the stagger, so the collage is all-or-nothing. */
const GALLERY_MIN = 4;

const gallery = (await getCollection('gallery')).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);
const show = gallery.length >= GALLERY_MIN;
---

{
  show && (
    <section class:list={['section', `surface-${surface}`]} data-reveal>
      <div class="container stack">
        <h2 class="label">{heading}</h2>
        <ul class="gallery">
          {gallery.map((entry) => (
            <li class="gallery__item">
              <Image class="photo gallery__img" src={entry.data.image} alt={entry.data.alt} width={640} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__img {
    width: 100%;
    height: auto;
  }

  /* 2 columns, every second item dropped. */
  @media (min-width: 600px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery__item:nth-child(2n) {
      margin-top: var(--space-3);
    }
  }

  /* 4 columns, columns 2 and 4 dropped. */
  @media (min-width: 900px) {
    .gallery {
      grid-template-columns: repeat(4, 1fr);
    }

    .gallery__item:nth-child(2n) {
      margin-top: 0;
    }

    .gallery__item:nth-child(4n + 2),
    .gallery__item:nth-child(4n + 4) {
      margin-top: var(--space-4);
    }
  }
</style>
