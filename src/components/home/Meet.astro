---
/**
 * Home 04 — Meet your narrator (spec v2 §3). Panel card: portrait left, the
 * first two bio paragraphs (Vikki's verbatim wording, src/data/bio.ts), her
 * signature, then "Read my story". Accents row below the card.
 */
import { Image } from 'astro:assets';
import SectionHead from '../SectionHead.astro';
import Dust from '../Dust.astro';
import { bio } from '../../data/bio';
import { accents } from '../../data/taxonomy';
import portrait from '../../assets/portrait.jpg';
---

<section class="section surface-base meet" aria-labelledby="meet-title">
  <Dust seed={44} />
  <div class="container reveal">
    <SectionHead chapter={4} label="Meet your narrator" id="meet-title">
      The voice behind the <em>story.</em>
    </SectionHead>

    <div class="card card--panel meet__panel">
      <div class="meet__figure photo-stage">
        <div class="photo-frame meet__frame">
          <Image
            src={portrait}
            alt="Victoria Rojas seated in her studio, smiling, with a pair of over-ear headphones beside her"
            width={800}
            height={1000}
            widths={[400, 800]}
            sizes="(min-width: 900px) 400px, 86vw"
            fit="cover"
            position="center"
            quality={65}
          />
        </div>
        <span class="spark" style="top:-12px;right:22%" aria-hidden="true"></span>
        <span class="spark" style="bottom:18%;left:-12px" aria-hidden="true"></span>
      </div>

      <div class="meet__copy">
        {bio.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}
        <p class="hand meet__signature">Victoria</p>
        <a class="btn btn--bookplate meet__cta" href="/about">
          Read my story
          <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="meet__accents">
      <h3 class="eyebrow meet__accents-label">Accents and dialects</h3>
      <ul class="star-list">
        {accents.map((accent) => <li>{accent}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .meet {
    position: relative;
    overflow: hidden;
  }

  .meet > .container {
    position: relative;
  }

  .meet__panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    padding: var(--space-3);
  }

  .meet__figure {
    justify-self: center;
    width: min(400px, 100%);
  }

  .meet__frame {
    aspect-ratio: 4 / 5;
  }

  .meet__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--c-text-card);
  }

  .meet__signature {
    align-self: flex-start;
    font-size: 44px;
  }

  .meet__cta {
    align-self: flex-start;
  }

  .meet__accents {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    text-align: center;
  }

  .meet__accents .star-list {
    justify-content: center;
    color: var(--c-text-body);
  }

  @media (min-width: 900px) {
    .meet__panel {
      grid-template-columns: 2fr 3fr;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-4);
    }
  }
</style>
