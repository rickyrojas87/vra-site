---
/**
 * Home 04 — Meet your narrator (artboard section.meet). One panel: portrait
 * left; eyebrow, title, the two short paragraphs (bioShort), signature and
 * "Read my story" right. Accents row below the panel.
 */
import { Image } from 'astro:assets';
import SectionHead from '../SectionHead.astro';
import GoldThread from '../GoldThread.astro';
import Dust from '../Dust.astro';
import { bioShort } from '../../data/bio';
import { accents } from '../../data/taxonomy';
import portrait from '../../assets/portrait.jpg';
---

<section class="section surface-base meet" aria-labelledby="meet-title">
  <GoldThread />
  <Dust seed={44} />
  <div class="container meet__wrap">
    <div class="meet-grid reveal">
      <div class="photo-stage meet-photo">
        <div class="photo-frame meet__frame">
          <Image
            src={portrait}
            alt="Victoria Rojas smiling in a studded armchair beside her headphones"
            width={840}
            widths={[420, 840]}
            sizes="(min-width: 901px) 420px, 90vw"
            quality={65}
            loading="lazy"
            fetchpriority="low"
          />
        </div>
        <span class="spark" style="top:-12px;left:30px" aria-hidden="true"></span>
        <span class="spark spark--small" style="bottom:60px;right:-20px" aria-hidden="true"></span>
      </div>

      <div class="meet__copy">
        <SectionHead chapter={4} label="Meet your narrator" id="meet-title">
          Stories play in my mind <em>like a film.</em>
        </SectionHead>
        <p class="meet__p1">{bioShort[0]}</p>
        <p class="meet__p2">{bioShort[1]}</p>
        <p class="hand meet__signature">Victoria</p>
        <a class="btn btn--bookplate meet__cta" href="/about">
          Read my story
          <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="meet__accents">
      <h3 class="eyebrow meet__accents-label">Accents and dialects</h3>
      <ul class="star-list">
        {accents.map((accent) => <li>{accent}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .meet {
    overflow: hidden;
    padding-block: 140px 130px;
  }

  .meet__wrap {
    position: relative;
  }

  .meet-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 72px;
    align-items: center;
    padding: 56px;
    border-radius: 28px;
    background: linear-gradient(160deg, var(--c-panel), var(--c-panel-shade) 70%, var(--c-panel-green) 160%);
    box-shadow:
      0 30px 80px rgb(0 0 0 / 45%),
      inset 0 0 0 1px var(--c-card-edge);
  }

  .meet-photo {
    height: 560px;
    margin: 30px;
  }

  .meet__frame {
    height: 100%;
  }

  .meet__frame :global(img) {
    object-position: 50% 25%;
  }

  .spark--small {
    width: 13px;
    height: 13px;
    animation-delay: 1.5s;
  }

  /* Column, so the signature and button keep their own lines. */
  .meet__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .meet__p1 {
    margin-top: 28px;
    color: var(--c-text-soft);
  }

  .meet__p2 {
    margin-top: 18px;
    color: var(--c-text-soft-2);
  }

  .meet__signature {
    margin-top: 30px;
    font-size: 44px;
  }

  .meet__cta {
    margin-top: 36px;
  }

  .meet__accents {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    text-align: center;
  }

  .meet__accents .star-list {
    justify-content: center;
    color: var(--c-text-body);
  }

  @media (max-width: 900px) {
    .meet {
      padding-block: 110px 100px;
    }

    .meet-grid {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 24px 20px;
    }

    .meet-photo {
      height: 420px;
      margin: 20px 20px 10px;
    }
  }
</style>
