---
/**
 * Home 04 — Meet your narrator (artboard section.meet). One panel: portrait
 * left; eyebrow, title, the two short paragraphs (bioShort), signature,
 * accents and "Read my story" right.
 */
import { Image } from 'astro:assets';
import SectionHead from '../SectionHead.astro';
import GoldThread from '../GoldThread.astro';
import Dust from '../Dust.astro';
import Spark from '../Spark.astro';
import { bioShort } from '../../data/bio';
import { accents } from '../../data/taxonomy';
import portrait from '../../assets/portrait.jpg';
---

<section class="section surface-base meet" aria-labelledby="meet-title">
  <GoldThread />
  <Dust seed={44} />
  <div class="container meet__wrap">
    <div class="meet-grid reveal">
      <div class="photo meet-photo">
        <div class="photo-frame frame">
          <Image
            src={portrait}
            alt="Victoria Rojas smiling in a studded armchair beside her headphones"
            width={420}
            height={560}
            densities={[1, 2]}
            quality={85}
            loading="lazy"
            fetchpriority="low"
          />
        </div>
        <Spark style="top:-12px;left:30px" />
        <Spark style="bottom:60px;right:-20px;width:13px;height:13px;animation-delay:1.5s" />
      </div>

      <div>
        <SectionHead chapter={4} label="Meet your narrator" id="meet-title">
          Stories play in my mind <em>like a film.</em>
        </SectionHead>
        <p class="meet__p1">{bioShort[0]}</p>
        <p class="meet__p2">{bioShort[1]}</p>
        <p class="sig">
          <svg viewBox="0 0 72 22" preserveAspectRatio="none" aria-hidden="true">
            <path
              d="M1.5 14.5 C 10 7, 22 5.5, 36 9.2 C 48 12.3, 58 11.6, 70.5 6.4 C 60 13.6, 47 16.2, 35 13.2 C 23 10.2, 11 11.4, 1.5 14.5 Z"
              fill="currentColor"></path>
          </svg>Victoria
        </p>
        <h3 class="eyebrow meet__accents-label">Accents and dialects</h3>
        <ul class="star-list accents">
          {accents.map((accent) => <li>{accent}</li>)}
        </ul>
        <div class="meet__cta">
          <a class="btn btn--bookplate" href="/about">
            Read my story
            <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .meet {
    overflow: hidden;
    padding-block: 140px 130px;
  }

  .meet__wrap {
    position: relative;
  }

  .meet-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 72px;
    align-items: center;
    padding: 56px;
    border-radius: 28px;
    background: linear-gradient(160deg, var(--c-panel), var(--c-panel-shade) 70%, var(--c-panel-green) 160%);
    box-shadow:
      0 30px 80px rgb(0 0 0 / 45%),
      inset 0 0 0 1px var(--c-card-edge);
  }

  .meet-photo {
    height: 560px;
    margin: 30px;
  }

  .meet-photo .frame {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .meet-photo :global(img) {
    object-position: 50% 25%;
  }

  .meet__p1 {
    margin-top: 28px;
    color: var(--c-text-soft);
  }

  .meet__p2 {
    margin-top: 18px;
    color: var(--c-text-soft-2);
  }

  /* The signature centres itself; here it sits with the copy. */
  .meet-grid .sig {
    justify-content: flex-start;
  }

  .meet__accents-label {
    margin-top: 36px;
  }

  .meet__cta {
    margin-top: 36px;
  }

  @media (max-width: 900px) {
    .meet {
      padding-block: 110px 100px;
    }

    .meet-grid {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 24px 20px;
    }

    .meet-photo {
      height: 420px;
      margin: 20px 20px 10px;
    }
  }
</style>
