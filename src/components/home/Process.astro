---
/**
 * Home 05 — How we work together (artboard section.process). Six chapter
 * cards in one row (three at <=900px, one at <=560px). Each card: a progress
 * bar that draws in on load (17/33/50/67/83/100%), the italic numeral with
 * "Chapter N" ("The end" on the last), a ghost roman numeral in the corner,
 * then title and copy.
 *
 * Steps come from settings/process.yaml (CMS), short copy. With no usable
 * steps the section renders nothing; index.astro adjusts the next join.
 */
import SectionHead from '../SectionHead.astro';
import GoldThread from '../GoldThread.astro';
import { loadProcessSteps } from '../../utils/content';

const steps = await loadProcessSteps();
const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
---

{
  steps.length > 0 && (
    <section class="section surface-deep join join--from-base process" aria-labelledby="process-title">
      <GoldThread />
      <div class="container">
        <SectionHead chapter={5} label="How we work together" id="process-title">
          From manuscript to <em>Audible</em>, in six chapters.
        </SectionHead>

        <ol class="steps reveal">
          {steps.map((step) => (
            <li class="step">
              <div class="prog" role="presentation">
                <span style={`width:${step.progress}%`} />
              </div>
              <div class="step-top">
                <span class="num" aria-hidden="true">
                  {step.n}
                </span>
                <span class="step-k">{step.last ? 'The end' : `Chapter ${step.n}`}</span>
              </div>
              <span class="ghostnum" aria-hidden="true">
                {ROMAN[step.n - 1] ?? step.n}
              </span>
              <h3>{step.title}</h3>
              <p>{step.short}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
    margin: 64px 0 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    overflow: hidden;
    padding: 24px 20px;
    border-radius: var(--radius-card);
    background: var(--c-bg);
    box-shadow:
      var(--shadow-card),
      inset 0 0 0 1px var(--c-card-edge);
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  .step:hover {
    transform: translateY(-6px);
    box-shadow:
      0 40px 80px rgb(0 0 0 / 50%),
      inset 0 0 0 1px var(--c-accent);
  }

  .prog {
    height: 3px;
    margin-bottom: 28px;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(200 184 162 / 16%);
  }

  .prog span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--c-emerald), var(--c-accent));
    transform-origin: left;
    animation: draw 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .step:nth-child(2) .prog span {
    animation-delay: 0.15s;
  }

  .step:nth-child(3) .prog span {
    animation-delay: 0.3s;
  }

  .step:nth-child(4) .prog span {
    animation-delay: 0.45s;
  }

  .step:nth-child(5) .prog span {
    animation-delay: 0.6s;
  }

  .step:nth-child(6) .prog span {
    animation-delay: 0.75s;
  }

  .step-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .step-k {
    margin-top: 6px;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--c-quiet);
  }

  .ghostnum {
    position: absolute;
    right: 14px;
    bottom: -20px;
    font-family: var(--font-display);
    font-size: 110px;
    line-height: 1;
    color: rgb(212 175 55 / 6%);
    pointer-events: none;
  }

  .step:last-child .num::after {
    width: 100%;
    background: linear-gradient(90deg, var(--c-accent), var(--c-emerald));
  }

  .step h3 {
    margin: 20px 0 8px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.15;
  }

  .step p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--c-text-card);
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .step {
      padding: 26px 22px 24px;
    }
  }
</style>
