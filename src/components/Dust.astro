---
/**
 * Dust motes — gold specks drifting up through a section (spec v2 §2). Place
 * inside a `position: relative` section; the layer fills it and ignores the
 * pointer. Styles and the `dust` keyframe are in global.css.
 *
 * Positions come from a seeded generator so every build emits identical
 * markup — no diff noise, no layout change between deploys. Pass a different
 * `seed` per section so neighbouring sections don't share a pattern.
 */
interface Props {
  count?: number;
  seed?: number;
}

const { count = 26, seed = 1 } = Astro.props;

// mulberry32
let s = seed >>> 0;
const rand = () => {
  s = (s + 0x6d2b79f5) >>> 0;
  let t = s;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const round = (n: number, d = 2) => Number(n.toFixed(d));

const motes = Array.from({ length: count }, () => {
  const duration = 9 + rand() * 9;
  return {
    '--x': `${round(rand() * 100)}%`,
    '--y': `${round(10 + rand() * 85)}%`,
    '--s': `${round(1.5 + rand() * 2.5, 1)}px`,
    '--d': `${round(duration, 1)}s`,
    // Negative delay starts each mote mid-flight, so the layer is already
    // populated on load instead of fading in all at once.
    '--delay': `${round(-rand() * duration, 1)}s`,
    '--drift': `${round((rand() - 0.5) * 60, 0)}px`,
    '--o': round(0.35 + rand() * 0.5),
  };
});
---

<div class="dust" aria-hidden="true">
  {motes.map((style) => <span class="dust__mote" style={style}></span>)}
</div>
