---
/**
 * Contact — the approved artboard, docs/design/Contact.html.
 *
 * Surfaces, as drawn: hero (poster) → 01 base over the library spines (joins
 * from panel, fades out to deep) → 02 deep (joins from base) → 03 panel
 * (joins from deep) → footer deep.
 *
 * 01 keeps the full QuoteCalculator (the artboard draws the compact Home
 * estimator here). The intake form keeps every field name, type and the
 * required ones; only the layout, labels and button text follow the
 * artboard. Its identity and field names are checked against the generated
 * /__forms.html on every build (scripts/check-forms.mjs).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import HeroPreloads from '../components/HeroPreloads.astro';
import { Image } from 'astro:assets';
import SectionHead from '../components/SectionHead.astro';
import GoldThread from '../components/GoldThread.astro';
import QuoteCalculator from '../components/QuoteCalculator.astro';
import { site, professionalLinks } from '../data/site';
import spines from '../assets/library-spines.png';
import { genreOptions, dealTypes } from '../data/taxonomy';
/* Shared with the generated Netlify detection file at /__forms.html, so the two
   cannot disagree about the form's identity. `npm run build` asserts the field
   names match as well — see scripts/check-forms.mjs. */
import { FORM_NAME, HONEYPOT_FIELD } from '../data/intakeForm';

/** Email first, then the two professional profiles (artboard .direct). */
const profileCopy = {
  acx: { label: 'ACX', link: 'Narrator profile ↗', note: 'For royalty share and ACX auditions.' },
  audible: { label: 'Audible', link: 'Narrator page ↗', note: 'Every published title in one place.' },
} as const;

const direct = [
  { label: 'Email', link: site.email, note: site.responseTime, href: `mailto:${site.email}`, external: false },
  ...professionalLinks.map((l) => {
    const copy = profileCopy[l.id as 'acx' | 'audible'] ?? { label: l.label, link: `${l.label} ↗`, note: '' };
    return { label: copy.label, link: copy.link, note: copy.note, href: l.href, external: true };
  }),
];
---

<BaseLayout
  title="Hire an Audiobook Narrator, Request a Quote"
  description="Tell me about your book and I'll come back within two business days with availability and a quote."
>
  <HeroPreloads slot="head" />

  <PageHero title="Request a quote" subline="I reply within two business days" />

  {/* 01 — Starting estimate */}
  <section
    class="section surface-base join join--from-panel join--to-deep estimate"
    id="estimate"
    aria-labelledby="estimate-title"
  >
    <div class="bgfade" aria-hidden="true">
      <Image class="cta-bg" src={spines} alt="" width={1600} format="webp" quality={60} sizes="100vw" loading="lazy" fetchpriority="low" />
    </div>
    <GoldThread />
    <div class="container cta-grid reveal">
      <div>
        <SectionHead chapter={1} label="Starting estimate" id="estimate-title" class="estimate__head">
          What will <em>your book</em> cost?
        </SectionHead>
        <p class="estimate__copy">
          Slide to your word count. Estimated finished hours are your word count divided by 9,300. The
          final quote comes after I read the manuscript.
        </p>
      </div>
      <QuoteCalculator formTarget="intake" showRates />
    </div>
  </section>

  {/* 02 — Intake form. Fields 5, 6 and 8 are the qualifying ones — never cut them. */}
  <section class="section surface-deep join join--from-base" id="intake" aria-labelledby="intake-title">
    <GoldThread />
    <div class="container">
      <SectionHead chapter={2} label="Tell me about your book" id="intake-title">
        The <em>details.</em>
      </SectionHead>

      {/*
        `action` is where Netlify redirects after it accepts the POST.
        Detection itself happens from the generated /__forms.html — Netlify's
        build parser does not see forms rendered from .astro components, which
        is why submissions used to 404. Field names here must stay in sync with
        src/data/intakeForm.ts.
      */}
      <div class="form-card reveal">
        <form
          class="form"
          name={FORM_NAME}
          method="POST"
          action="/thanks"
          data-netlify="true"
          netlify-honeypot={HONEYPOT_FIELD}
        >
          <input type="hidden" name="form-name" value={FORM_NAME} />
          <p class="form__honeypot">
            <label>Leave this field empty <input name={HONEYPOT_FIELD} tabindex="-1" /></label>
          </p>

          <div class="field">
            <label class="field__label" for="name">Name</label>
            <input class="field__input" id="name" name="name" type="text" required />
          </div>

          <div class="field">
            <label class="field__label" for="email">Email</label>
            <input class="field__input" id="email" name="email" type="email" required />
          </div>

          <div class="field">
            <label class="field__label" for="bookTitle">Book title</label>
            <input class="field__input" id="bookTitle" name="bookTitle" type="text" required />
          </div>

          <div class="field">
            <label class="field__label" for="genre">Genre</label>
            <select class="field__input" id="genre" name="genre">
              <option value="">Select a genre</option>
              {genreOptions.map((genre) => <option value={genre}>{genre}</option>)}
            </select>
          </div>

          <div class="field">
            <label class="field__label" for="wordCount">Word count</label>
            <input
              class="field__input"
              id="wordCount"
              name="wordCount"
              type="number"
              min="0"
              step="1000"
              required
            />
          </div>

          <div class="field">
            <label class="field__label" for="dealType">Deal type</label>
            <select class="field__input" id="dealType" name="dealType">
              <option value="">Select a deal type</option>
              {dealTypes.map((deal) => <option value={deal}>{deal}</option>)}
            </select>
          </div>

          <div class="field">
            <label class="field__label" for="deliveryDate">Target delivery date</label>
            <input class="field__input" id="deliveryDate" name="deliveryDate" type="date" />
          </div>

          {/* Radios, not the artboard's Yes/No select: a select would arrive
              pre-answered "Yes", and this is a qualifying question. */}
          <fieldset class="field field--fieldset">
            <legend class="field__label">Is the manuscript final?</legend>
            <div class="field__choices">
              <label class="choice">
                <input type="radio" name="manuscriptFinal" value="Yes" required /> Yes
              </label>
              <label class="choice">
                <input type="radio" name="manuscriptFinal" value="No" /> No
              </label>
            </div>
          </fieldset>

          <div class="field field--full">
            <label class="field__label" for="manuscriptUrl">Link to manuscript or sample</label>
            <input
              class="field__input"
              id="manuscriptUrl"
              name="manuscriptUrl"
              type="url"
              placeholder="https://"
            />
          </div>

          <div class="field field--full">
            <label class="field__label" for="notes">Anything else</label>
            <textarea class="field__input" id="notes" name="notes"></textarea>
          </div>

          <div class="form__actions">
            <button class="btn btn--primary" type="submit">
              Send my request
              <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  {/* 03 — Or reach me directly */}
  <section class="section surface-panel join join--from-deep direct-sec" aria-labelledby="direct-title">
    <GoldThread />
    <div class="container">
      <SectionHead chapter={3} label="Or reach me directly" id="direct-title">
        Prefer <em>email?</em>
      </SectionHead>

      <ul class="direct reveal">
        {
          direct.map((item) => (
            <li class="direct__card">
              <p class="direct__label">{item.label}</p>
              {item.href ? (
                <a
                  class="direct__link"
                  href={item.href}
                  {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {item.link}
                </a>
              ) : (
                <span class="direct__link is-pending" title="URL still needed">
                  {item.link}
                </span>
              )}
              {item.note && <p class="direct__note">{item.note}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* 01 — Starting estimate (artboard section.cta, opening 120px down) */
  .estimate {
    overflow: hidden;
    padding-block: 120px 150px;
  }

  .bgfade {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    mask-image: linear-gradient(180deg, transparent 0, #000 34%, #000 66%, transparent 100%);
  }

  .bgfade :global(.cta-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 70% 50%;
    opacity: 0.4;
    mask-image: linear-gradient(90deg, transparent 0, #000 45%);
    animation: breathe 34s ease-in-out infinite alternate;
  }

  .cta-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .estimate__head :global(.section-title) {
    font-size: 56px;
  }

  .estimate__copy {
    max-width: 460px;
    margin-top: 22px;
    color: var(--c-text-soft);
  }

  /* 02 — Form (artboard .form / .field) */
  .form-card {
    margin-top: 48px;
    padding: 44px;
    border-radius: var(--radius-card);
    background: var(--c-bg);
    box-shadow:
      var(--shadow-card),
      inset 0 0 0 1px var(--c-card-edge);
  }

  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 20px;
  }

  .form__honeypot {
    position: absolute;
    left: -9999px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field--full,
  .form__actions {
    grid-column: 1 / -1;
  }

  .field--fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .field__label {
    padding: 0;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  /* `color-scheme: dark` draws the date picker's icon light on the dark field. */
  .field__input {
    width: 100%;
    min-height: 50px;
    padding: 12px 16px;
    border: 0;
    border-radius: var(--radius-btn);
    background: var(--c-panel);
    box-shadow: inset 0 0 0 1px rgb(184 146 90 / 35%);
    color: var(--c-text-body);
    color-scheme: dark;
    font-family: var(--font-body);
    font-size: 16px;
  }

  .field__input:focus-visible {
    box-shadow: inset 0 0 0 1px var(--c-accent);
  }

  textarea.field__input {
    min-height: 130px;
    resize: vertical;
  }

  .field__choices {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 50px;
  }

  /* The whole label is the radio's target: 44px tall. */
  .choice {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    cursor: pointer;
    color: var(--c-text-body);
  }

  .choice input {
    width: 18px;
    height: 18px;
    accent-color: var(--c-accent);
  }

  .form__actions {
    margin-top: 10px;
  }

  /* 03 — Direct (artboard .direct) */
  .direct-sec {
    padding-bottom: 120px;
  }

  .direct {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .direct__card {
    padding: 30px 28px;
    border-radius: var(--radius-card);
    background: var(--c-bg);
    box-shadow:
      var(--shadow-card),
      inset 0 0 0 1px var(--c-card-edge);
  }

  /* Artboard .label: 12px / .16em at <=560 (below). */
  .direct__label {
    font-size: 13px;
    font-weight: var(--fw-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .direct__link {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--c-accent);
    overflow-wrap: anywhere;
  }

  a.direct__link:hover {
    color: var(--c-text);
  }

  .direct__link.is-pending {
    opacity: 0.5;
  }

  .direct__note {
    margin-top: 10px;
    font-size: 14px;
    color: var(--c-muted);
  }

  @media (max-width: 900px) {
    .estimate {
      padding-block: 120px 100px;
    }

    .cta-grid,
    .form,
    .direct {
      grid-template-columns: 1fr;
    }

    .estimate__head :global(.section-title) {
      font-size: 44px;
    }

    .direct-sec {
      padding-bottom: 120px;
    }
  }

  @media (max-width: 560px) {
    .form-card {
      padding: 28px 20px;
    }

    .direct__label {
      font-size: 12px;
      letter-spacing: 0.16em;
    }
  }
</style>
