---
/** Contact — spec section 6. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteCalculator from '../components/QuoteCalculator.astro';
import { site, professionalLinks } from '../data/site';
import { genreOptions, dealTypes } from '../data/taxonomy';
/* Shared with the generated Netlify detection file at /__forms.html, so the two
   cannot disagree about the form's identity. `npm run build` asserts the field
   names match as well — see scripts/check-forms.mjs. */
import { FORM_NAME, HONEYPOT_FIELD } from '../data/intakeForm';
---

<BaseLayout
  title="Hire an Audiobook Narrator, Request a Quote"
  description="Tell me about your book and I'll come back within two business days with availability and a quote."
>
  {/* 1 — Title */}
  <PageHeader
    title="Request a quote"
    subhead="Tell me about your book and I'll come back within two business days."
  />

  {/* 2 — Calculator */}
  <section class="section surface-deep" data-reveal>
    <div class="container stack">
      <h2 class="label">Estimate</h2>
      <QuoteCalculator formTarget="intake" />
    </div>
  </section>

  {/* 3 — Intake form. Fields 5, 6 and 8 are the qualifying ones — never cut them. */}
  <section class="section surface-base" id="intake" data-reveal>
    <div class="container stack">
      <h2 class="label">Project details</h2>

      {/*
        `action` is where Netlify redirects after it accepts the POST.
        Detection itself happens from public/__forms.html — Netlify's build
        parser does not see forms rendered from .astro components, which is why
        submissions used to 404. Field names here must stay in sync with that
        file.
      */}
      <form
        class="form"
        name={FORM_NAME}
        method="POST"
        action="/thanks"
        data-netlify="true"
        netlify-honeypot={HONEYPOT_FIELD}
      >
        <input type="hidden" name="form-name" value={FORM_NAME} />
        <p class="form__honeypot">
          <label>Leave this field empty <input name={HONEYPOT_FIELD} tabindex="-1" /></label>
        </p>

        <div class="form__row">
          <div class="field">
            <label class="field__label" for="name">Name <span class="field__req">*</span></label>
            <input class="field__input" id="name" name="name" type="text" required />
          </div>

          <div class="field">
            <label class="field__label" for="email">Email <span class="field__req">*</span></label>
            <input class="field__input" id="email" name="email" type="email" required />
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="bookTitle">
            Book title <span class="field__req">*</span>
          </label>
          <input class="field__input" id="bookTitle" name="bookTitle" type="text" required />
        </div>

        <div class="form__row">
          <div class="field">
            <label class="field__label" for="genre">Genre</label>
            <select class="field__input" id="genre" name="genre">
              <option value="">Select a genre</option>
              {genreOptions.map((genre) => <option value={genre}>{genre}</option>)}
            </select>
          </div>

          <div class="field">
            <label class="field__label" for="wordCount">
              Word count <span class="field__req">*</span>
            </label>
            <input
              class="field__input"
              id="wordCount"
              name="wordCount"
              type="number"
              min="0"
              step="1000"
              required
            />
          </div>
        </div>

        <div class="form__row">
          <div class="field">
            <label class="field__label" for="dealType">Deal type</label>
            <select class="field__input" id="dealType" name="dealType">
              <option value="">Select a deal type</option>
              {dealTypes.map((deal) => <option value={deal}>{deal}</option>)}
            </select>
          </div>

          <div class="field">
            <label class="field__label" for="deliveryDate">Target delivery date</label>
            <input class="field__input" id="deliveryDate" name="deliveryDate" type="date" />
          </div>
        </div>

        <fieldset class="field field--fieldset">
          <legend class="field__label">
            Is the manuscript final? <span class="field__req">*</span>
          </legend>
          <div class="field__choices">
            <label class="choice">
              <input type="radio" name="manuscriptFinal" value="Yes" required /> Yes
            </label>
            <label class="choice">
              <input type="radio" name="manuscriptFinal" value="No" /> No
            </label>
          </div>
        </fieldset>

        <div class="field">
          <label class="field__label" for="manuscriptUrl">Link to manuscript or sample</label>
          <input
            class="field__input"
            id="manuscriptUrl"
            name="manuscriptUrl"
            type="url"
            placeholder="https://"
          />
        </div>

        <div class="field">
          <label class="field__label" for="notes">Anything else</label>
          <textarea class="field__input" id="notes" name="notes" rows="5"></textarea>
        </div>

        <button class="btn btn--primary form__submit" type="submit">Send request</button>
      </form>
    </div>
  </section>

  {/* 4 — Direct */}
  <section class="section surface-panel" data-reveal>
    <div class="container stack">
      <h2 class="label">Direct</h2>
      <div class="direct">
        <div class="direct__block">
          <a class="direct__email" href={`mailto:${site.email}`}>{site.email}</a>
          <p class="muted">{site.responseTime}</p>
        </div>

        <ul class="direct__links">
          {
            professionalLinks.map((link) => (
              <li>
                {link.href ? (
                  <a class="direct__link" href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ) : (
                  <span class="direct__link is-pending" title="URL still needed">
                    {link.label}
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* 3 — Form */
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 760px;
  }

  .form__honeypot {
    position: absolute;
    left: -9999px;
  }

  .form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field--fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .field__label {
    padding: 0;
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .field__req {
    color: var(--c-accent);
  }

  .field__input {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    background: var(--c-panel);
    border: 1px solid var(--c-rule);
    border-radius: 2px;
    color: var(--c-text);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: 1.4;
  }

  .field__input:focus-visible {
    border-color: var(--c-accent);
  }

  textarea.field__input {
    resize: vertical;
  }

  .field__choices {
    display: flex;
    gap: var(--space-2);
    margin-top: 8px;
  }

  .choice {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--c-text);
  }

  .choice input {
    accent-color: var(--c-accent);
  }

  .form__submit {
    align-self: flex-start;
    margin-top: var(--space-1);
  }

  /* 4 — Direct */
  .direct {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .direct__block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .direct__email {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-h3);
    letter-spacing: var(--ls-h3);
    color: var(--c-text);
  }

  .direct__email:hover {
    color: var(--c-accent);
  }

  .direct__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .direct__link {
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-accent-2);
  }

  a.direct__link:hover {
    color: var(--c-accent);
  }

  .direct__link.is-pending {
    color: var(--c-muted);
    opacity: 0.5;
  }

  @media (min-width: 768px) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }

    .direct {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
