---
/** Home — spec section 3. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WaveformPlayer from '../components/WaveformPlayer.astro';
import Proof from '../components/Proof.astro';
import TitleSchema from '../components/TitleSchema.astro';
import TitleCard from '../components/TitleCard.astro';
import DeliverySpec from '../components/DeliverySpec.astro';
import CtaBand from '../components/CtaBand.astro';

const selected = (await getCollection('titles', ({ data }) => data.status === 'published'))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 4);
---

<BaseLayout
  title="Victoria Rojas, Audiobook Narrator, Central Texas"
  description="Audiobook narration from a treated, ACX-compliant studio in Central Texas. Hear demos and request a quote."
>
  {/* 1 — Hero. Not revealed: it holds the LCP element. */}
  <Hero />

  {/* 2 — Demo player. The single most important element on the site. */}
  <WaveformPlayer surface="deep" id="demos" />

  {/* 3 — Selected titles. Panel, so the Proof strip below can sit on base and
      still read its own #2C2D33 panel against the section behind it. */}
  <section class="section surface-panel" data-reveal>
    <div class="container stack">
      <h2 class="label">Selected titles</h2>
      <div class="titles-grid">
        {selected.map((entry) => <TitleCard entry={entry} />)}
      </div>
    </div>
  </section>

  {/* 4 — Proof */}
  <Proof surface="base" />

  {/* 5 — Delivery spec. Deep, so the #2C2D33 panel reads against it. */}
  <section class="section surface-deep" data-reveal>
    <div class="container stack">
      <h2 class="label">Studio and delivery</h2>
      <DeliverySpec />
    </div>
  </section>

  {/* 6 — CTA band. Base, so it differs from both the panel above and the footer. */}
  <CtaBand surface="base" />

  {/* Structured data for the titles this page actually renders. */}
  <TitleSchema entries={selected} />
</BaseLayout>

<style>
  /* Hero styles live in Hero.astro. */

  /* Shared section rhythm */
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* 3 — Selected titles */
  .titles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
  }

  /* 4 — Proof */
  .proof {
    display: flex;
    justify-content: center;
  }

  .proof > :global(*) {
    max-width: 720px;
  }

  /* auto-fit so 3 titles fill the row as well as 4 do. */
  @media (min-width: 768px) {
    .titles-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }
</style>
