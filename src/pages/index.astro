---
/** Home — spec section 3. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Placeholder from '../components/Placeholder.astro';
import TitleCard from '../components/TitleCard.astro';
import DeliverySpec from '../components/DeliverySpec.astro';
import CtaBand from '../components/CtaBand.astro';

const selected = (await getCollection('titles', ({ data }) => data.status === 'published'))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 4);
---

<BaseLayout
  title="Victoria Rojas, Audiobook Narrator, Central Texas"
  description="Audiobook narration from a treated, ACX-compliant studio in Central Texas. Hear demos and request a quote."
>
  {/* 1 — Hero. Not revealed: it holds the LCP element. */}
  <Hero />

  {/* 2 — Demo player */}
  <section class="section surface-deep" id="demos" data-reveal>
    <div class="container stack">
      <p class="label">Demos</p>
      <Placeholder
        label="Waveform demo player embed"
        note="Genre pills across the top, one player below. Blocked on demo audio files with final labels."
        height="420px"
      />
    </div>
  </section>

  {/* 3 — Selected titles */}
  <section class="section surface-base" data-reveal>
    <div class="container stack">
      <p class="label">Selected titles</p>
      <div class="titles-grid">
        {selected.map((entry) => <TitleCard entry={entry} />)}
      </div>
    </div>
  </section>

  {/* 4 — Proof */}
  <section class="section surface-panel" data-reveal>
    <div class="container proof">
      <Placeholder
        label="Author testimonial"
        note="Cormorant Garamond 28px italic, attribution in 13px champagne. Two lines is enough."
        height="220px"
      />
    </div>
  </section>

  {/* 5 — Delivery spec. Deep, so the #2C2D33 panel reads against it. */}
  <section class="section surface-deep" data-reveal>
    <div class="container stack">
      <p class="label">Studio and delivery</p>
      <DeliverySpec />
    </div>
  </section>

  {/* 6 — CTA band. Base, so it differs from both the panel above and the footer. */}
  <CtaBand surface="base" />
</BaseLayout>

<style>
  /* Hero styles live in Hero.astro. */

  /* Shared section rhythm */
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* 3 — Selected titles */
  .titles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
  }

  /* 4 — Proof */
  .proof {
    display: flex;
    justify-content: center;
  }

  .proof > :global(*) {
    max-width: 720px;
  }

  /* auto-fit so 3 titles fill the row as well as 4 do. */
  @media (min-width: 768px) {
    .titles-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }
</style>
