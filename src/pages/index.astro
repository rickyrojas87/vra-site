---
/**
 * Home — spec v2 §3 and §4, "The Library".
 *
 * Surfaces down the page, each joining the last with a 240px fade:
 *   hero (video) → stats deep → 01 deep → 02 panel → 03 library (fades in
 *   and out) → 04 base → 05 deep → 06 panel → 07 base (fades out) → footer deep
 *
 * Every section after the hero opens with the gold thread and a chapter
 * eyebrow, and its main block fades up on load (`.reveal`).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StatsStrip from '../components/StatsStrip.astro';
import WaveformPlayer from '../components/WaveformPlayer.astro';
import Shelf from '../components/home/Shelf.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Meet from '../components/home/Meet.astro';
import Process from '../components/home/Process.astro';
import Studio from '../components/Studio.astro';
import StartHere from '../components/home/StartHere.astro';
import TitleSchema from '../components/TitleSchema.astro';
import HeroPreloads from '../components/HeroPreloads.astro';
import { loadShelf } from '../utils/catalog';
import { loadProcessSteps } from '../utils/content';

const { items: shelf } = await loadShelf(4);
/** Process hides when the CMS list is empty; Studio then joins from Meet. */
const hasProcess = (await loadProcessSteps()).length > 0;
---

<BaseLayout
  title="Victoria Rojas, Audiobook Narrator, Central Texas"
  description="Audiobook narration from a treated, ACX-compliant studio in Central Texas. Hear demos and request a quote."
>
  {/* The hero poster is the LCP element. Preloaded so the browser finds it
      before parsing the inlined stylesheet that fills the rest of <head>. */}
  <HeroPreloads slot="head" />

  <Hero />
  <StatsStrip />
  <WaveformPlayer surface="deep" id="demos" chapter={1} ambient />
  <Shelf />
  <Testimonials />
  <Meet />
  <Process />
  <Studio joinFrom={hasProcess ? 'deep' : 'base'} />
  <StartHere />

  {/* Structured data for the titles this page actually renders. */}
  <TitleSchema entries={shelf.map((item) => item.entry)} />
</BaseLayout>

<style>
  /* Everything after the hero and stats strip is below the fold on load at
     every width. Skipping its rendering until it nears the viewport keeps its
     images and the italic face from downloading alongside the LCP poster
     (mobile Lighthouse: ~190 KB moved out of the critical window). The
     intrinsic size is a placeholder only; `auto` remembers the real height
     once a section has rendered, so scrolling back never jumps. */
  :global(main > section:nth-of-type(n + 3)) {
    content-visibility: auto;
    contain-intrinsic-size: auto 1100px;
  }
</style>
