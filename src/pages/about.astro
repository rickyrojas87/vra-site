---
/**
 * About — spec v2 §5.
 *
 * Surfaces: hero (poster, fades to deep) → 01 deep → 02 panel → 03 base →
 * 04 deep → CTA panel (fades out) → footer deep. Each section after 01 joins
 * the last with the 240px fade.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import HeroPreloads from '../components/HeroPreloads.astro';
import SectionHead from '../components/SectionHead.astro';
import Studio from '../components/Studio.astro';
import CtaBand from '../components/CtaBand.astro';
import Dust from '../components/Dust.astro';
import { loadGallery, loadProcessSteps, loadPublishedTitles } from '../utils/content';
import { genres, accents } from '../data/taxonomy';
import { bio } from '../data/bio';
import portrait from '../assets/portrait.jpg';
/* Laughing mid-take: Home's studio section already uses the booth shot. */
import studioPhoto from '../assets/main.jpg';

/**
 * Which genres she has actually published in, read straight off the catalog so
 * the emphasis can never drift from reality. Add a title with a new genre and
 * it moves into "Narrated" on the next build with no edit here.
 *
 * The rendered list is the union of the taxonomy and the catalog: a genre that
 * exists on a published title but is missing from taxonomy.ts still appears,
 * rather than silently vanishing from the page.
 */
const publishedTitles = await loadPublishedTitles();
const publishedGenres = new Set(
  publishedTitles.map((t) => t.data.genre).filter((g): g is string => Boolean(g)),
);

const allGenres = [...new Set([...genres, ...publishedGenres])];
/** Catalog-backed, alphabetical. Anything here is a genre she has shipped. */
const narrated = allGenres.filter((g) => publishedGenres.has(g)).sort();
/** Everything else, in taxonomy order. */
const availableFor = allGenres.filter((g) => !publishedGenres.has(g));

/** settings/process.yaml, long copy. Empty hides section 02. */
const steps = await loadProcessSteps();

/** "In the booth": the first three gallery photos, in CMS order. */
const booth = (await loadGallery()).slice(0, 3);
---

<BaseLayout
  title="About Victoria Rojas, Female Audiobook Narrator"
  description="Audiobook narrator based in Central Texas, recording and mastering in a treated home studio to professional delivery standards."
>
  <HeroPreloads slot="head" />

  <PageHero eyebrow="Audiobook narrator" title="About" subline="Pleased to meet you." />

  {/* 01 — Meet Victoria */}
  <section class="section surface-deep meet" aria-labelledby="meet-title">
    <Dust seed={44} />
    <div class="container reveal">
      <SectionHead chapter={1} label="Meet Victoria" id="meet-title">
        The voice behind the <em>story.</em>
      </SectionHead>

      <div class="card card--panel meet__panel">
        <div class="meet__figure photo-stage">
          <div class="photo-frame meet__frame">
            <Image
              src={portrait}
              alt="Victoria Rojas seated in her studio, smiling, with a pair of over-ear headphones beside her"
              width={800}
              height={1000}
              widths={[400, 800]}
              sizes="(min-width: 900px) 400px, 86vw"
              fit="cover"
              position="center"
              quality={65}
            />
          </div>
          <span class="spark" style="top:-12px;right:22%" aria-hidden="true"></span>
          <span class="spark" style="bottom:18%;left:-12px" aria-hidden="true"></span>
        </div>

        <div class="meet__copy">
          {bio.map((paragraph) => <p>{paragraph}</p>)}
          <p class="hand meet__signature">Victoria</p>
        </div>
      </div>

      {/* Accents and dialects | Genres */}
      <div class="range">
        <div class="card card--panel range__card">
          <h3 class="eyebrow">Accents and dialects</h3>
          <ul class="star-list">
            {accents.map((accent) => <li>{accent}</li>)}
          </ul>
        </div>

        <div class="card card--panel range__card">
          <h3 class="eyebrow">Genres</h3>
          <div class="range__group">
            <h4 class="range__sub">Narrated</h4>
            <ul class="star-list">
              {narrated.map((genre) => <li>{genre}</li>)}
            </ul>
          </div>
          {
            availableFor.length > 0 && (
              <div class="range__group">
                <h4 class="range__sub">Also available for</h4>
                <ul class="star-list range__list--quiet">
                  {availableFor.map((genre) => <li>{genre}</li>)}
                </ul>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {/* 02 — How we work together, long form */}
  {
    steps.length > 0 && (
      <section class="section surface-panel join join--from-deep" aria-labelledby="process-title">
        <div class="container reveal">
          <SectionHead chapter={2} label="How we work together" id="process-title">
            From manuscript to <em>finished audiobook.</em>
          </SectionHead>

          <ol class="steps">
            {
              steps.map((step) => (
                <li class="card steps__card">
                  <span class="steps__numeral" aria-hidden="true">
                    {step.n}
                  </span>
                  <div class="steps__body">
                    <p class="steps__chapter">{step.last ? 'The end' : `Chapter ${step.n}`}</p>
                    <h3 class="steps__title">{step.title}</h3>
                    <p class="steps__copy">{step.long}</p>
                    <span class="steps__bar" role="presentation" style={`--progress:${step.progress}%`} />
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>
    )
  }

  {/* 03 — The studio */}
  <Studio
    chapter={3}
    surface="base"
    joinFrom={steps.length > 0 ? 'panel' : 'deep'}
    photo={studioPhoto}
    alt="Victoria Rojas laughing mid-take at the microphone, headphones on and a script tablet in her hand"
    position="50% 30%"
  />

  {/* 04 — In the booth. CMS-managed photos; hidden until there are three. */}
  {
    booth.length === 3 && (
      <section class="section surface-deep join join--from-base" aria-labelledby="booth-title">
        <div class="container reveal">
          <SectionHead chapter={4} label="In the booth" id="booth-title">
            Behind the <em>microphone.</em>
          </SectionHead>

          <ul class="booth">
            {booth.map((entry) => (
              <li class="photo-frame booth__frame">
                <Image
                  src={entry.data.image}
                  alt={entry.data.alt}
                  width={720}
                  height={900}
                  widths={[360, 720]}
                  sizes="(min-width: 700px) 340px, 86vw"
                  fit="cover"
                  position="center"
                  quality={65}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand joinFrom={booth.length === 3 ? 'deep' : 'base'} />
</BaseLayout>

<style>
  /* 01 — Meet Victoria */
  /* `clip`, not `hidden`: hidden would make the section a scroll container
     and the sticky portrait below would never stick. */
  .meet {
    position: relative;
    overflow: clip;
  }

  .meet > .container {
    position: relative;
  }

  .meet__panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    padding: var(--space-3);
  }

  .meet__figure {
    justify-self: center;
    width: min(400px, 100%);
  }

  .meet__frame {
    aspect-ratio: 4 / 5;
  }

  .meet__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--c-text-card);
  }

  .meet__signature {
    align-self: flex-start;
    font-size: 44px;
  }

  .range {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .range__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    color: var(--c-text-body);
  }

  .range__group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .range__sub {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: var(--fw-label);
    letter-spacing: 0.04em;
    color: var(--c-text-caption);
  }

  .range__list--quiet {
    color: var(--c-text-card);
  }

  /* 02 — Process, stacked */
  .steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 860px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .steps__card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1);
    padding: var(--space-3);
  }

  .steps__numeral {
    font-family: var(--font-display);
    font-size: var(--fs-numeral);
    font-style: italic;
    font-weight: 300;
    line-height: 0.9;
    color: var(--c-accent);
  }

  .steps__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .steps__chapter {
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-text-caption);
  }

  .steps__title {
    font-size: var(--fs-h3);
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--c-text-body);
  }

  .steps__copy {
    color: var(--c-text-card);
  }

  .steps__bar {
    display: block;
    height: 3px;
    margin-top: var(--space-1);
    border-radius: 2px;
    background:
      linear-gradient(90deg, var(--c-emerald), var(--c-accent)) 0 0 / var(--progress) 100% no-repeat,
      var(--c-card-edge);
  }

  /* 04 — In the booth */
  .booth {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .booth__frame {
    aspect-ratio: 4 / 5;
  }

  @media (min-width: 640px) {
    .steps__card {
      grid-template-columns: 88px 1fr;
      gap: var(--space-3);
    }
  }

  @media (min-width: 700px) {
    .range {
      grid-template-columns: 1fr 1fr;
    }

    .booth {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2);
    }
  }

  @media (min-width: 900px) {
    .meet__panel {
      grid-template-columns: 2fr 3fr;
      align-items: start;
      gap: var(--space-4);
      padding: var(--space-4);
    }

    /* The full bio runs taller than the portrait; keep the photo in view. */
    .meet__figure {
      position: sticky;
      top: calc(var(--header-h) + var(--space-3));
    }
  }
</style>
