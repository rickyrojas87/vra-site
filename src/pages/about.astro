---
/**
 * About — the approved artboard, docs/design/About.html.
 *
 * Surfaces: hero (poster, fades to base) → 01 base → 02 deep (joins from
 * base) → 03 panel (from deep) → 04 panel (from deep, as drawn) → closing band
 * base (from panel, fades out) → footer deep.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import HeroPreloads from '../components/HeroPreloads.astro';
import SectionHead from '../components/SectionHead.astro';
import GoldThread from '../components/GoldThread.astro';
import Studio from '../components/Studio.astro';
import CtaBand from '../components/CtaBand.astro';
import { loadGallery, loadProcessSteps, loadPublishedTitles } from '../utils/content';
import { genres, accents } from '../data/taxonomy';
import { bio } from '../data/bio';
import portrait from '../assets/portrait.jpg';

/**
 * The genre list in taxonomy order, plus any genre she has published in that
 * the taxonomy lacks, so the catalog can never be contradicted here.
 */
const publishedGenres = (await loadPublishedTitles())
  .map((t) => t.data.genre)
  .filter((g): g is string => Boolean(g));
const genreList = [...new Set([...genres, ...publishedGenres])];

/** settings/process.yaml, long copy. Empty hides section 02. */
const steps = await loadProcessSteps();

/** "In the booth": the first three gallery photos, in CMS order. */
const booth = (await loadGallery()).slice(0, 3);
---

<BaseLayout
  title="About Victoria Rojas, Female Audiobook Narrator"
  description="Audiobook narrator based in Central Texas, recording and mastering in a treated home studio to professional delivery standards."
>
  <HeroPreloads slot="head" />

  <PageHero title="About" subline="the voice behind the books" />

  {/* 01 — Meet Victoria */}
  <section class="section surface-base bio-sec" aria-labelledby="meet-title">
    <GoldThread />
    <div class="container">
      <SectionHead chapter={1} label="Meet Victoria" id="meet-title">
        Stories play in my mind <em>like a film.</em>
      </SectionHead>

      <div class="bio reveal">
        <div class="photo bio__photo">
          <div class="photo-frame frame">
          <Image
            src={portrait}
            alt="Victoria Rojas smiling in a studded armchair beside her headphones"
            width={1000}
            widths={[500, 1000]}
            sizes="(min-width: 901px) 470px, 90vw"
            quality={65}
            loading="lazy"
            fetchpriority="low"
          />
          </div>
        </div>
        <div class="bio__copy">
          {bio.map((paragraph) => <p>{paragraph}</p>)}
          <p class="sig">
            <svg viewBox="0 0 72 22" preserveAspectRatio="none" aria-hidden="true">
              <path
                d="M1.5 14.5 C 10 7, 22 5.5, 36 9.2 C 48 12.3, 58 11.6, 70.5 6.4 C 60 13.6, 47 16.2, 35 13.2 C 23 10.2, 11 11.4, 1.5 14.5 Z"
                fill="currentColor"></path>
            </svg>Victoria
          </p>
        </div>
      </div>

      <div class="lists2 reveal">
        <div>
          <h3 class="list-label">Accents and dialects</h3>
          <ul class="star-list">
            {accents.map((accent) => <li>{accent}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="list-label">Genres</h3>
          <ul class="star-list">
            {genreList.map((genre) => <li>{genre}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* 02 — How we work together, long form */}
  {
    steps.length > 0 && (
      <section class="section surface-deep join join--from-base" aria-labelledby="process-title">
        <GoldThread />
        <div class="container">
          <SectionHead chapter={2} label="How we work together" id="process-title">
            From manuscript to <em>Audible</em>, in six chapters.
          </SectionHead>

          <ol class="chapters reveal">
            {steps.map((step) => (
              <li class="chap">
                <div>
                  <span class="num" aria-hidden="true">
                    {step.n}
                  </span>
                </div>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.long}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {/* 03 — The studio */}
  <Studio chapter={3} joinFrom={steps.length > 0 ? 'deep' : 'base'} />

  {/* 04 — In the booth. CMS-managed photos; hidden until there are three. */}
  {
    booth.length === 3 && (
      <section class="section surface-panel join join--from-deep booth-sec" aria-labelledby="booth-title">
        <GoldThread />
        <div class="container">
          <SectionHead chapter={4} label="In the booth" id="booth-title">
            Where the <em>stories</em> get told.
          </SectionHead>

          <ul class="collage reveal">
            {booth.map((entry) => (
              <li class="collage__card">
                <Image
                  src={entry.data.image}
                  alt={entry.data.alt}
                  width={760}
                  widths={[380, 760]}
                  sizes="(min-width: 901px) 360px, 90vw"
                  quality={65}
                  loading="lazy"
                  fetchpriority="low"
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand joinFrom="panel" />
</BaseLayout>

<style>
  /* 01 — Meet Victoria (artboard .meet / .bio) */
  .bio-sec {
    padding-block: 140px 130px;
  }

  .bio {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: start;
    margin-top: 48px;
  }

  .bio__photo {
    height: 620px;
    margin: 30px 30px 0 0;
  }

  .bio__photo .frame {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .bio__photo :global(img) {
    object-position: 50% 25%;
  }

  .bio__copy p:not(.sig) {
    margin: 0 0 18px;
    font-size: 17px;
    color: var(--c-text-soft);
  }

  .lists2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-top: 56px;
    padding-top: 48px;
    border-top: 1px solid rgb(184 146 90 / 25%);
  }

  /* Artboard .label: 12px / .16em at <=560 (below). */
  .list-label {
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: var(--fw-label);
    letter-spacing: 0.2em;
    line-height: var(--lh-body);
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .lists2 .star-list {
    margin-top: 28px;
  }

  /* 02 — Process, long form (artboard .chapters / .chap) */
  .chapters {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .chap {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 28px;
    align-items: start;
    padding: 30px 34px;
    border-radius: var(--radius-card);
    background: var(--c-bg);
    box-shadow:
      var(--shadow-card),
      inset 0 0 0 1px var(--c-card-edge);
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  .chap:hover {
    transform: translateY(-4px);
    box-shadow:
      0 40px 80px rgb(0 0 0 / 50%),
      inset 0 0 0 1px var(--c-accent);
  }

  .chap h3 {
    margin: 4px 0 8px;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
  }

  .chap p {
    margin: 0;
    font-size: 16px;
    color: var(--c-text-card);
  }

  /* 04 — In the booth (artboard .collage) */
  .booth-sec {
    padding-block: 120px;
  }

  .collage {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .collage__card {
    height: 360px;
    overflow: hidden;
    border-radius: var(--radius-card);
    box-shadow:
      var(--shadow-card),
      inset 0 0 0 1px var(--c-card-edge);
  }

  .collage__card :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .bio-sec,
    .booth-sec {
      padding-block: 110px 100px;
    }

    .bio,
    .lists2,
    .collage {
      grid-template-columns: 1fr;
    }

    .bio__photo {
      height: 420px;
      margin: 20px 20px 10px;
    }

    .chap {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .collage__card {
      height: 260px;
    }
  }

  @media (max-width: 560px) {
    .list-label {
      font-size: 12px;
      letter-spacing: 0.16em;
    }
  }
</style>
