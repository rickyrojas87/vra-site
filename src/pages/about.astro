---
/** About — spec section 4. Two images maximum on this page: portrait and booth. */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import DeliverySpec from '../components/DeliverySpec.astro';
import Gallery from '../components/Gallery.astro';
import CtaBand from '../components/CtaBand.astro';
import { genres, accents } from '../data/taxonomy';

/**
 * Which genres she has actually published in, read straight off the catalog so
 * the emphasis can never drift from reality. Add a title with a new genre and
 * that pill lights up on the next build with no edit here.
 *
 * The rendered list is the union of the taxonomy and the catalog: a genre that
 * exists on a published title but is missing from taxonomy.ts still appears,
 * rather than silently vanishing from the page.
 */
const publishedTitles = await getCollection('titles', ({ data }) => data.status === 'published');
const publishedGenres = new Set(
  publishedTitles.map((t) => t.data.genre).filter((g): g is string => Boolean(g)),
);

const allGenres = [...new Set([...genres, ...publishedGenres])];
/** Catalog-backed, alphabetical. Anything here is a genre she has shipped. */
const narrated = allGenres.filter((g) => publishedGenres.has(g)).sort();
/** Everything else, in taxonomy order. */
const availableFor = allGenres.filter((g) => !publishedGenres.has(g));
import portrait from '../assets/portrait.jpg';
/* Studio slot. Stronger frame for a studio context than the booth shot, which
   moved into the collage. */
import studio from '../assets/main.jpg';

/**
 * Verbatim source copy. Do not reword, condense, or "fix" anything here — this
 * is Vikki's own wording, character for character, and edits to it are hers to
 * make. Paragraph 3 is the spec's one change: the sentence beginning "I am a
 * newer voice in the industry" is deleted outright, with nothing put in its place.
 */
const bio = [
  "Hi, I'm Victoria, a narrator based in Central Texas with a lifelong love for the arts and storytelling. I approach my work with care, discipline, and a deep respect for the craft, always focused on delivering performances that feel authentic, immersive, and thoughtfully produced.",
  'My connection to storytelling began long before stepping into the booth. Some of my favorite moments happen at bedtime, reading to my two kids and watching their faces light up as I bring different character voices to life. Those moments quietly shaped my path into voice acting and clarified my mission. I strive to captivate listeners and pull them fully into the story, creating an experience that feels engaging, emotional, and alive.',
  'I have worked closely with experienced audio engineers and voice actors to refine both performance and production, ensuring each audiobook meets high professional standards from start to finish. My background in music has also shaped how I listen and perform, giving me a strong sensitivity to rhythm, pacing, and tonal nuance.',
  'When I am not in production, I am often reading for pleasure. Stories play in my mind like a film, unfolding frame by frame with clear voices, vivid scenes, and emotional detail. That is the experience I aim to give every listener, a story that feels immersive, intentional, and memorable.',
];
---

<BaseLayout
  title="About Victoria Rojas, Female Audiobook Narrator"
  description="Audiobook narrator based in Central Texas, recording and mastering in a treated home studio to professional delivery standards."
>
  {/* 1 — Title */}
  <PageHeader title="About" />

  {/* 2 — Bio, 5/7 split */}
  <section class="section surface-deep" data-reveal>
    <div class="container bio">
      <div class="bio__portrait">
        {/* Fills the column height so both columns end on the same line. */}
        <Image
          class="photo"
          src={portrait}
          alt="Victoria Rojas seated in her studio beside a pair of over-ear headphones, acoustic panelling behind her"
          width={900}
          height={1125}
        />
      </div>

      <div class="bio__copy">
        {bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  {/* 3 + 4 — Range and Genres, one block. Both are short lists; two full-height
      bands spent a screen each on a dozen words. */}
  <section class="section surface-base" data-reveal>
    <div class="container rg">
      <div class="rg__col">
        <div class="rg__group">
          <h2 class="label">Range</h2>
          <p class="rg__intro">Accents and dialects performed in character work.</p>
          {
            accents.length > 0 ? (
              <ul class="tags">
                {accents.map((accent) => (
                  <li class="tag">{accent}</li>
                ))}
              </ul>
            ) : (
              <p class="muted">Accents to be confirmed.</p>
            )
          }
        </div>
      </div>

      {/* No "Genres" header above these two: it would sit in the same label
          token directly above "Narrated" and read as a duplicate. The group
          labels carry it, and genre names are self-evident in context. */}
      <div class="rg__col">
        <div class="rg__group">
          <h2 class="label">Narrated</h2>
          <ul class="tags">
            {narrated.map((genre) => <li class="tag tag--pill is-published">{genre}</li>)}
          </ul>
        </div>

        <div class="rg__group">
          <h2 class="label">Also available for</h2>
          <ul class="tags">
            {availableFor.map((genre) => <li class="tag tag--pill">{genre}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* 5 — Studio. Same panel as Home section 5, reused not rewritten. */}
  <section class="section surface-deep" data-reveal>
    <div class="container stack">
      <h2 class="label">Studio and delivery</h2>
      {/* Booth beside the panel, both stretched to the same height. */}
      <div class="studio">
        <figure class="studio__photo">
          <Image
            class="photo"
            src={studio}
            alt="Victoria Rojas laughing mid-take at the microphone, headphones on and a script tablet in her hand"
            width={1120}
          />
        </figure>
        <DeliverySpec />
      </div>
    </div>
  </section>

  {/* Self-hides until there are at least four images. */}
  <Gallery surface="panel" />

  {/* 6 — CTA band */}
  <CtaBand />
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* 2 — Bio */
  .bio {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  /* The image is taken out of flow so it can't contribute to the grid row
     height — the copy column alone sets it, and the photo crops to match.
     With `height: 100%` alone the img's intrinsic size still influences row
     sizing and the columns drift apart again. */
  .bio__portrait {
    position: relative;
    min-height: 320px;
  }

  .bio__portrait :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  /* 5 — Booth beside the delivery panel, equal height. */
  .studio {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
    align-items: stretch;
  }

  /* Same treatment: the delivery panel sets the height, the booth crops to it. */
  .studio__photo {
    position: relative;
    margin: 0;
    min-height: 320px;
  }

  .studio__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .bio__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-text);
  }

  /* 3 + 4 — Range and Genres */
  .rg {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  /* 40px between groups, 16px from a label to its own content — so the two
     genre groups read as siblings rather than one continuous list. */
  .rg__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .rg__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .rg__col .label {
    margin: 0;
    font-family: var(--font-body);
  }

  .rg__intro {
    max-width: 60ch;
    color: var(--c-muted);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Inline tags, wrapping naturally — no grid, so no orphan rows.
     Sized against this page's 17px body copy, not a mockup. font-family and
     weight are declared rather than inherited so a future change to the list
     elements can't quietly drop them to the UA default. */
  .tag {
    padding: 7px 14px;
    border: 1px solid rgb(184 146 90 / 55%);
    border-radius: 3px;
    color: var(--c-text);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .tag--pill {
    border-radius: 20px;
    color: var(--c-muted);
  }

  /* Filled = she has a published title in this genre. Driven by the catalog. */
  .tag--pill.is-published {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-bg);
  }


  @media (min-width: 700px) {
    .rg {
      grid-template-columns: 1fr 1.35fr;
    }
  }

  /* Same 768px boundary the global type scale uses for its desktop step. */
  @media (min-width: 768px) {
    .tag {
      font-size: 14px;
    }
  }

  @media (min-width: 768px) {
    .bio {
      grid-template-columns: 5fr 7fr;
      gap: var(--gutter);
      /* Both columns end on the same line. */
      align-items: stretch;
    }

    .studio {
      grid-template-columns: 1fr 1.5fr;
    }
  }
</style>
