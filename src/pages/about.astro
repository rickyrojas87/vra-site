---
/** About — spec section 4. Two images maximum on this page: portrait and booth. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Placeholder from '../components/Placeholder.astro';
import DeliverySpec from '../components/DeliverySpec.astro';
import CtaBand from '../components/CtaBand.astro';
import { genres, accents } from '../data/taxonomy';

/**
 * Bio copy carried over verbatim from victoriarojasaudio.com/about.
 *
 * Paragraph 3 is the one edit the spec calls for: the sentence beginning "I am a
 * newer voice in the industry" is gone, and the spec's replacement sentence
 * stands in for it. That replacement also subsumes the original's near-identical
 * follow-on sentence ("I have worked closely with experienced audio engineers
 * ...ensuring each audiobook meets high professional standards"), which would
 * otherwise repeat the same clause twice. Every other word is hers.
 */
const bio = [
  "Hi, I'm Victoria, a narrator based in Central Texas with a lifelong love for the arts and storytelling. I approach my work with care, discipline, and a deep respect for the craft, always focused on delivering performances that feel authentic, immersive, and thoughtfully produced.",
  'My connection to storytelling began long before stepping into the booth. Some of my favorite moments happen at bedtime, reading to my two kids and watching their faces light up as I bring different character voices to life. Those moments quietly shaped my path into voice acting and clarified my mission. I strive to captivate listeners and pull them fully into the story, creating an experience that feels engaging, emotional, and alive.',
  "I've worked closely with experienced audio engineers and voice actors to refine both performance and production, so every title meets professional delivery standards start to finish. My background in music has also shaped how I listen and perform, giving me a strong sensitivity to rhythm, pacing, and tonal nuance.",
  'When I am not in production, I am often reading for pleasure. Stories play in my mind like a film, unfolding frame by frame with clear voices, vivid scenes, and emotional detail. That is the experience I aim to give every listener, a story that feels immersive, intentional, and memorable.',
];
---

<BaseLayout
  title="About Victoria Rojas, Female Audiobook Narrator"
  description="Audiobook narrator based in Central Texas, recording and mastering in a treated home studio to professional delivery standards."
>
  {/* 1 — Title */}
  <PageHeader eyebrow="Narrator, Central Texas" title="About" />

  {/* 2 — Bio, 5/7 split */}
  <section class="section">
    <div class="container bio">
      <div class="bio__portrait">
        <Placeholder
          label="Portrait"
          note="Full resolution, 4:5. One of the two images allowed on this page."
          ratio="4 / 5"
        />
      </div>

      <div class="bio__copy">
        {bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  {/* 3 — Range */}
  <section class="section">
    <div class="container stack">
      <p class="label">Range</p>
      {
        accents.length > 0 ? (
          <ul class="accent-grid">
            {accents.map((accent) => (
              <li class="accent-grid__cell">{accent}</li>
            ))}
          </ul>
        ) : (
          <Placeholder
            label="Accent and voice range"
            note="Interim treatment is a 3-column grid of accent names, never a comma list. Add them to accents[] in src/data/taxonomy.ts. Superseded by the voice range matrix in phase 2."
            height="232px"
          />
        )
      }
    </div>
  </section>

  {/* 4 — Genres */}
  <section class="section">
    <div class="container stack">
      <p class="label">Genres</p>
      <ul class="genre-row">
        {genres.map((genre) => <li class="pill">{genre}</li>)}
      </ul>
    </div>
  </section>

  {/* 5 — Studio. Same panel as Home section 5, reused not rewritten. */}
  <section class="section">
    <div class="container stack">
      <p class="label">Studio and delivery</p>
      <DeliverySpec />
      <Placeholder
        label="Booth photo"
        note="The second and final image on this page."
        ratio="3 / 2"
      />
    </div>
  </section>

  {/* 6 — CTA band */}
  <CtaBand />
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* 2 — Bio */
  .bio {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .bio__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-text);
  }

  /* 3 — Range */
  .accent-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .accent-grid__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding: var(--space-1);
    background: var(--c-panel);
    color: var(--c-text);
    font-size: var(--fs-body);
    text-align: center;
  }

  /* 4 — Genres */
  .genre-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .bio {
      grid-template-columns: 5fr 7fr;
      gap: var(--gutter);
      align-items: start;
    }
  }
</style>
