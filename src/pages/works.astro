---
/** Works — spec section 5. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import TitleCard from '../components/TitleCard.astro';
import WaveformPlayer from '../components/WaveformPlayer.astro';
import CtaBand from '../components/CtaBand.astro';

const all = await getCollection('titles');
const byOrder = (a: { data: { sortOrder: number } }, b: { data: { sortOrder: number } }) =>
  a.data.sortOrder - b.data.sortOrder;

const published = all.filter((e) => e.data.status === 'published').sort(byOrder);
const inProduction = all.filter((e) => e.data.status === 'in-production').sort(byOrder);
---

<BaseLayout
  title="Audiobook Narration Demos and Published Titles"
  description="Narration demos across genres and character types, plus published audiobook titles and works currently in production."
>
  {/* 1 — Title */}
  <PageHeader title="Works" />

  {/* 2 — Demos */}
  <WaveformPlayer surface="deep" id="demos" />

  {/* 3 — Published titles */}
  <section class="section surface-base" data-reveal>
    <div class="container stack">
      <p class="label">Published titles</p>
      {
        published.length > 0 ? (
          <div class="titles-grid">
            {published.map((entry) => (
              <TitleCard entry={entry} showMeta />
            ))}
          </div>
        ) : (
          <p class="muted">No published titles yet.</p>
        )
      }
    </div>
  </section>

  {/* 4 — In production */}
  {
    inProduction.length > 0 && (
      <section class="section surface-panel" data-reveal>
        <div class="container stack">
          <p class="label">In production</p>
          <div class="titles-grid">
            {inProduction.map((entry) => (
              <TitleCard entry={entry} showMeta />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* 5 — CTA band */}
  <CtaBand />
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* 2 — Demos */
  .demos {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .demo {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2);
    background: var(--c-panel);
    border-radius: var(--radius-panel);
  }

  .demo__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1);
  }

  .demo__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-h3);
    letter-spacing: var(--ls-h3);
    line-height: var(--lh-heading);
    color: var(--c-text);
  }

  .demo__flag {
    flex-shrink: 0;
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .demo__audio {
    width: 100%;
  }

  .demos__note {
    font-size: 13px;
  }

  /* 3 across desktop, 1 across mobile. */
  .titles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
  }

  @media (min-width: 768px) {
    .titles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
