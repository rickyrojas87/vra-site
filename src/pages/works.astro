---
/** Works — spec section 5. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Placeholder from '../components/Placeholder.astro';
import TitleCard from '../components/TitleCard.astro';
import CtaBand from '../components/CtaBand.astro';

const all = await getCollection('titles');
const byOrder = (a: { data: { sortOrder: number } }, b: { data: { sortOrder: number } }) =>
  a.data.sortOrder - b.data.sortOrder;

const published = all.filter((e) => e.data.status === 'published').sort(byOrder);
const inProduction = all.filter((e) => e.data.status === 'in-production').sort(byOrder);

/**
 * Demos are driven off the Titles collection so a sample never drifts from its
 * book. Native <audio> is the interim treatment until the waveform player embed
 * ships — that element replaces this block wholesale, including the filtering.
 *
 * Labels are titles for now. The spec's naming rule ("Title, Author" for book
 * samples, "Genre, character type" for character demos) needs author and genre,
 * which no entry has yet.
 */
const demos = all.filter((e) => e.data.sampleAudio).sort(byOrder);
---

<BaseLayout
  title="Audiobook Narration Demos and Published Titles"
  description="Narration demos across genres and character types, plus published audiobook titles and works currently in production."
>
  {/* 1 — Title */}
  <PageHeader title="Works" />

  {/* 2 — Demos */}
  <section class="section">
    <div class="container stack">
      <p class="label">Demos</p>
      {
        demos.length > 0 ? (
          <ul class="demos">
            {demos.map((entry) => (
              <li class="demo">
                <div class="demo__head">
                  <h2 class="demo__title">{entry.data.title}</h2>
                  {entry.data.status === 'in-production' && (
                    <span class="demo__flag">In production</span>
                  )}
                </div>
                <audio class="demo__audio" controls preload="none" src={entry.data.sampleAudio}>
                  <a href={entry.data.sampleAudio}>Download the {entry.data.title} sample</a>
                </audio>
              </li>
            ))}
          </ul>
        ) : (
          <Placeholder label="Demo audio" note="No sample audio wired to any title yet." height="520px" />
        )
      }
      <p class="demos__note muted">
        Interim players. The waveform embed with genre and accent filters replaces this
        section in phase 1.
      </p>
    </div>
  </section>

  {/* 3 — Published titles */}
  <section class="section">
    <div class="container stack">
      <p class="label">Published titles</p>
      {
        published.length > 0 ? (
          <div class="titles-grid">
            {published.map((entry) => (
              <TitleCard entry={entry} showMeta />
            ))}
          </div>
        ) : (
          <p class="muted">No published titles yet.</p>
        )
      }
    </div>
  </section>

  {/* 4 — In production */}
  {
    inProduction.length > 0 && (
      <section class="section">
        <div class="container stack">
          <p class="label">In production</p>
          <div class="titles-grid">
            {inProduction.map((entry) => (
              <TitleCard entry={entry} showMeta />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* 5 — CTA band */}
  <CtaBand />
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* 2 — Demos */
  .demos {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .demo {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2);
    background: var(--c-panel);
    border-radius: var(--radius-panel);
  }

  .demo__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1);
  }

  .demo__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-h3);
    letter-spacing: var(--ls-h3);
    line-height: var(--lh-heading);
    color: var(--c-text);
  }

  .demo__flag {
    flex-shrink: 0;
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .demo__audio {
    width: 100%;
  }

  .demos__note {
    font-size: 13px;
  }

  /* 3 across desktop, 1 across mobile. */
  .titles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter);
  }

  @media (min-width: 768px) {
    .titles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
