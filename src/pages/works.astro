---
/**
 * Works — the approved artboard, docs/design/Works.html.
 *
 * Surfaces, as drawn: hero (poster) → 01 room (deep, green glow) → 02 panel
 * (joins from deep) → 03 deep (joins from base) → closing band base (joins
 * from panel, fades out) → footer deep.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import HeroPreloads from '../components/HeroPreloads.astro';
import SectionHead from '../components/SectionHead.astro';
import GoldThread from '../components/GoldThread.astro';
import WaveformPlayer from '../components/WaveformPlayer.astro';
import BookCard from '../components/BookCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Dust from '../components/Dust.astro';
import TitleSchema from '../components/TitleSchema.astro';
import { loadInProductionTitles } from '../utils/content';
import { loadPublishedNewestFirst } from '../utils/catalog';

const published = await loadPublishedNewestFirst();
const inProduction = await loadInProductionTitles();
const newestId = published[0]?.id;

/** "Eight titles on Audible." — spelled out through twenty, digits after. */
const WORDS = 'Zero One Two Three Four Five Six Seven Eight Nine Ten Eleven Twelve Thirteen Fourteen Fifteen Sixteen Seventeen Eighteen Nineteen Twenty'.split(' ');
const count = WORDS[published.length] ?? String(published.length);
const titlesWord = published.length === 1 ? 'title' : 'titles';
---

<BaseLayout
  title="Audiobook Narration Demos and Published Titles"
  description="Narration demos across genres and character types, plus published audiobook titles and works currently in production."
>
  <HeroPreloads slot="head" />

  <PageHero title="Works" subline="every book on the shelf" />

  {/* 01 — The listening room, every demo */}
  <WaveformPlayer id="demos" chapter={1} details={false} class="room--works" />

  {/* 02 — Published */}
  <section class="section surface-panel join join--from-deep catalog-sec" id="published" aria-labelledby="published-title">
    <GoldThread />
    <Dust seed={22} />
    <div class="container catalog-sec__wrap">
      <SectionHead chapter={2} label="Published" id="published-title">
        {`${count} ${titlesWord} on `}<em>Audible.</em>
      </SectionHead>
      {
        published.length > 0 ? (
          <ul class="catalog reveal">
            {published.map((entry) => (
              <li>
                <BookCard
                  entry={entry}
                  ribbon={entry.id === newestId ? 'just-published' : null}
                  variant="catalog"
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="lede empty">No published titles yet.</p>
        )
      }
    </div>
  </section>

  {/* 03 — In production */}
  {
    inProduction.length > 0 && (
      <section class="section surface-deep join join--from-base" id="production" aria-labelledby="production-title">
        <GoldThread />
        <div class="container">
          <SectionHead chapter={3} label="In production" id="production-title">
            Coming <em>soon.</em>
          </SectionHead>
          <ul class="catalog reveal">
            {inProduction.map((entry) => (
              <li>
                <BookCard entry={entry} ribbon="in-production" variant="catalog" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand joinFrom="panel" />

  {/* Published titles only: in-production entries have no author, runtime or
      date, and a name-only node is not worth emitting. */}
  <TitleSchema entries={published} />
</BaseLayout>

<style>
  /* Artboard: the Works room opens 120px down rather than 140px. */
  :global(.room.room--works) {
    padding-top: 120px;
  }

  .catalog-sec {
    overflow: hidden;
    padding-block: 120px 100px;
  }

  .catalog-sec__wrap {
    position: relative;
  }

  .catalog {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    margin-top: 56px;
  }

  @media (max-width: 900px) {
    .catalog-sec {
      padding-block: 110px 100px;
    }

    .catalog {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .catalog {
      grid-template-columns: 1fr;
    }
  }
</style>
