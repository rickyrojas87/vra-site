---
/**
 * Works — spec v2 §5.
 *
 * Surfaces: hero (poster, fades to deep) → 01 deep → 02 panel → 03 base →
 * CTA panel (fades out) → footer deep. Without in-production titles 03 goes
 * and the CTA turns base, so no two neighbours ever share a surface.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PosterPreload from '../components/PosterPreload.astro';
import SectionHead from '../components/SectionHead.astro';
import WaveformPlayer from '../components/WaveformPlayer.astro';
import BookCard from '../components/BookCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Dust from '../components/Dust.astro';
import TitleSchema from '../components/TitleSchema.astro';
import { loadInProductionTitles } from '../utils/content';
import { loadPublishedNewestFirst } from '../utils/catalog';

const published = await loadPublishedNewestFirst();
const inProduction = await loadInProductionTitles();
const newestId = published[0]?.id;
---

<BaseLayout
  title="Audiobook Narration Demos and Published Titles"
  description="Narration demos across genres and character types, plus published audiobook titles and works currently in production."
>
  <PosterPreload slot="head" />

  <PageHero eyebrow="Demos and catalog" title="Works" subline="Pull up a chair." />

  {/* 01 — The listening room, every demo */}
  <WaveformPlayer surface="deep" id="demos" chapter={1} />

  {/* 02 — Published */}
  <section class="section surface-panel join join--from-deep shelf" aria-labelledby="published-title">
    <Dust seed={22} />
    <div class="container reveal">
      <SectionHead chapter={2} label="Published" id="published-title">
        On the <em>shelf.</em>
      </SectionHead>
      {
        published.length > 0 ? (
          <ul class="grid">
            {published.map((entry) => (
              <li>
                <BookCard
                  entry={entry}
                  ribbon={entry.id === newestId ? 'just-published' : null}
                  linkLabel
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="lede empty">No published titles yet.</p>
        )
      }
    </div>
  </section>

  {/* 03 — In production */}
  {
    inProduction.length > 0 && (
      <section class="section surface-base join join--from-panel" aria-labelledby="production-title">
        <div class="container reveal">
          <SectionHead chapter={3} label="In production" id="production-title">
            Coming <em>soon.</em>
          </SectionHead>
          <ul class="grid">
            {inProduction.map((entry) => (
              <li>
                <BookCard entry={entry} ribbon="in-production" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    inProduction.length > 0 ? (
      <CtaBand surface="panel" joinFrom="base" />
    ) : (
      <CtaBand surface="base" joinFrom="panel" />
    )
  }

  {/* Published titles only: in-production entries have no author, runtime or
      date, and a name-only node is not worth emitting. */}
  <TitleSchema entries={published} />
</BaseLayout>

<style>
  .shelf {
    position: relative;
    overflow: hidden;
  }

  .shelf > .container {
    position: relative;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    margin-inline: auto;
    text-align: center;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-3);
    }
  }
</style>
